class {
	property configManager;
	property gateways;
	property configured;

	function init( any configManager = null ) {
		variables.configManager = arguments.configManager
		variables.gateways = {}
		variables.configured = [ "telegram", "email", "discord", "slack", "whatsapp", "whatsapp-business", "signal", "sms" ]
		if ( !isNull( arguments.configManager ) ) { loadConfigured() }
		return this
	}

	private void function loadConfigured() {
		var stored = variables.configManager.get( "gateways", {} )
		for ( var name in stored ) { if ( variables.configured.contains( name ) ) { create( name, stored[ name ].config ?: {}, false ) } }
	}

	private string function classFor( required string name ) {
		var classes = { telegram: "nanobox-cli.TelegramGateway", email: "nanobox-cli.EmailGateway", discord: "nanobox-cli.DiscordGateway", slack: "nanobox-cli.SlackGateway", whatsapp: "nanobox-cli.WhatsAppGateway", "whatsapp-business": "nanobox-cli.WhatsAppBusinessGateway", signal: "nanobox-cli.SignalGateway", sms: "nanobox-cli.SMSGateway" }
		return classes[ lCase( arguments.name ) ] ?: ""
	}

	struct function register( required any gateway ) {
		if ( !isInstanceOf( arguments.gateway, "nanobox-cli.IGateway" ) ) { return { success: false, error: "Gateway must implement IGateway" } }
		variables.gateways[ gateway.getName() ] = gateway
		return { success: true, name: gateway.getName() }
	}
	struct function get( required string name ) { return variables.gateways[ lCase( arguments.name ) ] ?: {} }
	array function list() { var result = []; for ( var name in variables.gateways ) { var gateway = variables.gateways[ name ]; var item = gateway.status(); item.capabilities = gateway.capabilities(); result.append( item ) }; return result }
	struct function connect( required string name ) { var gateway = get( arguments.name ); return isObject( gateway ) ? gateway.connect() : { success: false, error: "Gateway not found" } }
	struct function disconnect( required string name ) { var gateway = get( arguments.name ); return isObject( gateway ) ? gateway.disconnect() : { success: false, error: "Gateway not found" } }
	struct function enable( required string name ) { return setEnabled( arguments.name, true ) }
	struct function disable( required string name ) { var result = setEnabled( arguments.name, false ); if ( result.success ) { disconnect( arguments.name ) }; return result }
	struct function restart( required string name ) { disconnect( arguments.name ); return connect( arguments.name ) }
	struct function setEnabled( required string name, required boolean enabled ) {
		var gateway = get( arguments.name )
		if ( !isObject( gateway ) ) { return { success: false, error: "Gateway not found" } }
		if ( !isNull( variables.configManager ) ) { variables.configManager.set( "gateways.#lCase( arguments.name )#.enabled", arguments.enabled ) }
		return { success: true, name: lCase( arguments.name ), enabled: arguments.enabled }
	}

	struct function create( required string name, struct config = {}, boolean save = true ) {
		var key = lCase( arguments.name )
		var className = classFor( key )
		if ( !len( className ) ) { return { success: false, error: "Unsupported gateway: #arguments.name#" } }
		var gateway = createObject( "class", className ).init( arguments.config )
		register( gateway )
		if ( arguments.save ) { persist( key, arguments.config ) }
		return { success: true, name: key, gateway: gateway }
	}
	struct function remove( required string name ) {
		var key = lCase( arguments.name )
		if ( !structKeyExists( variables.gateways, key ) ) { return { success: false, error: "Gateway not found" } }
		structDelete( variables.gateways, key )
		if ( !isNull( variables.configManager ) ) { variables.configManager.unset( "gateways.#key#" ) }
		return { success: true, name: key }
	}
	private void function persist( required string name, required struct config ) {
		if ( isNull( variables.configManager ) ) { return }
		var safeConfig = duplicate( arguments.config )
		for ( var key in [ "botToken", "apiKey", "password", "token", "secret" ] ) { if ( structKeyExists( safeConfig, key ) ) { structDelete( safeConfig, key ) } }
		variables.configManager.set( "gateways.#arguments.name#", { type: arguments.name, enabled: true, config: safeConfig } )
	}
}
