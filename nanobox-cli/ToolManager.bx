class {
	property homePath;
	property configManager;

	function init( string homePath = "", any configManager = null ) {
		if ( !isNull( arguments.configManager ) ) {
			variables.configManager = arguments.configManager
		} else {
			variables.configManager = new "/nanobox-cli/util/ConfigManager"()
		}
		variables.homePath = len( arguments.homePath ) ? arguments.homePath : expandPath( "~/.nanobox" )
		refresh()
		return this
	}

	function refresh() {
		var registry = aiToolRegistry()
		var coreDir = expandPath( "/nanobox-cli/tools" )
		var userDir = variables.homePath & "/tools"
		if ( !directoryExists( userDir ) ) { directoryCreate( userDir, true ) }

		// Scan shipped core tools (under /nanobox-cli mapping)
		if ( directoryExists( coreDir ) ) {
			for ( var file in directoryList( coreDir, false, "query", "*.bx" ) ) {
				try {
					var className = "nanobox-cli.tools." & file.name.replace( ".bx", "" )
					registry.scanClass( new "#className#"(), "nanobox" )
				} catch ( any e ) {
					writeLog( text: "ToolManager: Failed to load core tool #file.name#: #e.message#", type: "warn", log: "ai" )
				}
			}
		}

		// Register bx-ai FileSystemTools with path guards (read-only project + nanobox home)
		try {
			var allowed = [ expandPath( "." ), variables.homePath ]
			registry.scanClass(
				new "bxModules.bxai.models.tools.filesystem.FileSystemTools"( allowed ),
				"bxai"
			)
		} catch ( any e ) {
			writeLog( text: "ToolManager: Failed to register FileSystemTools: #e.message#", type: "warn", log: "ai" )
		}

		// Build index from registry + user tools
		var index = buildIndex()
		// Merge user tool metadata (for tracking, not runtime registration)
		if ( directoryExists( userDir ) ) {
			for ( var file in directoryList( userDir, false, "query", "*.bx" ) ) {
				var key = file.name.replace( ".bx", "" ) & "@user"
				if ( !index.keyExists( key ) ) {
					index[ key ] = {
						name: file.name.replace( ".bx", "" ),
						description: "User-installed tool",
						module: "user",
						enabled: false
					}
				}
			}
		}
		// Persist disk manifest
		writeIndex( index )
		return index
	}

	function list() {
		return buildIndex()
	}

	function show( required string key ) {
		var index = buildIndex()
		return index.keyExists( arguments.key ) ? index[ arguments.key ] : {}
	}

	function enable( required string key ) {
		var registry = aiToolRegistry()
		if ( !registry.has( arguments.key ) ) { return { success: false, error: "Tool not found in registry: " & arguments.key } }
		var enabled = getEnabledKeys()
		if ( !enabled.contains( arguments.key ) ) {
			enabled.append( arguments.key )
			saveEnabledKeys( enabled )
		}
		writeIndex( buildIndex() )
		return { success: true, key: arguments.key, enabled: true }
	}

	function disable( required string key ) {
		var registry = aiToolRegistry()
		if ( !registry.has( arguments.key ) ) { return { success: false, error: "Tool not found in registry: " & arguments.key } }
		var enabled = getEnabledKeys()
		if ( enabled.contains( arguments.key ) ) {
			enabled.delete( enabled.find( arguments.key ) )
			saveEnabledKeys( enabled )
		}
		writeIndex( buildIndex() )
		return { success: true, key: arguments.key, enabled: false }
	}

	function status() {
		var index = buildIndex()
		var enabledCount = 0
		var disabledCount = 0
		for ( var key in index ) {
			if ( index[ key ].enabled ) { enabledCount++ } else { disabledCount++ }
		}
		return { total: structCount( index ), enabled: enabledCount, disabled: disabledCount }
	}

	function getEnabledKeys() {
		var stored = variables.configManager.get( "bx-ai.enabledTools", "" )
		return len( stored ) ? listToArray( stored, "," ) : []
	}

	function saveEnabledKeys( required array keys ) {
		variables.configManager.set( "bx-ai.enabledTools", arrayToList( arguments.keys, "," ) )
	}

	function resolveActiveTools() {
		var keys = getEnabledKeys()
		if ( !keys.len() ) { return [] }
		return aiToolRegistry().resolveTools( keys )
	}

	// --- Private ---
	private struct function buildIndex() {
		var registry = aiToolRegistry()
		var all = registry.listTools()
		var enabledKeys = getEnabledKeys()
		var result = {}
		for ( var key in all ) {
			result[ key ] = {
				name: all[ key ].name,
				description: all[ key ].description,
				module: all[ key ].module,
				enabled: enabledKeys.contains( key )
			}
		}
		return result
	}

	private void function writeIndex( required struct index ) {
		var indexPath = variables.homePath & "/tools-index.json"
		try {
			var payload = {
				version: 1,
				updated: now().dateTimeFormat( "iso" ),
				tools: index
			}
			fileWrite( indexPath, jsonSerialize( payload, true ) )
		} catch ( any e ) {
			writeLog( text: "ToolManager: Failed to write index: #e.message#", type: "warn", log: "ai" )
		}
	}

	private string function moduleToPackage( required string filename ) {
		return "nanobox-cli.tools." & filename.replace( ".bx", "" )
	}
}