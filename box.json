{
    "name": "nanobox",
    "version": "0.1.0",
    "type": "projects",
    "language": "boxlang",
    "dependencies": {
        "testbox": "^7.1.0-snapshot",
        "bx-ai": "^3.4.0+18",
        "bx-sqlite": "^1.2.0+5"
    },
    "devDependencies": {
        "bx-sites": "1.0.0-snapshot"
    },
    "installPaths": {
        "testbox": "lib/testbox/",
        "bx-ai": "lib/modules/bx-ai/",
        "bx-sqlite": "lib/modules/bx-sqlite/",
        "bx-sites": "lib/modules/bx-sites/"
    },
    "testbox": {
        "runner": "./lib/testbox/run"
    },
    "scripts": {
        "test": "!./scripts/test --verbose",
        "test:unit": "!./scripts/test",
        "format:check": "!boxlang format --check --source app/,cli/,tests/,.bx",
        "docs:build": "!bxSites build",
        "docs:serve": "!bxSites serve",
        "docs:clean": "!bxSites clean"
    }
}
