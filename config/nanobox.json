{
	"$schema": "https://nanobox.io/schemas/v1/config.json",
	"nanobox": {
		"security": {
			"enabled": true,
			"autoDisable": true
		},
		"web": {
			"enabled": true,
			"host": "127.0.0.1",
			"port": 8080
		},
		"worker": {
			"enabled": true,
			"debug": false
		},
		"cron": {
			"enabled": true,
			"maxJobs": 50
		},
		"sessions": {
			"maxSessions": 1000,
			"enabled": true,
			"pruneAfterDays": 90
		},
		"tui": {
			"theme": "boxlang",
			"streaming": true,
			"wordWrap": true,
			"wrapWidth": 0,
			"statusBar": true,
			"colors": true,
			"markdownRender": true,
			"sidebarWidth": 22
		}
	},
	"bx-ai": {
		"defaultModel": "",
		"defaultProvider": "",
		"providers": {}
	},
	"version": "1"
}