{
	"clearClassFilesOnStartup": true,
	"classResolverCache": true,
	"trustedCache": false,
	"validClassExtensions": [
		"bx",
		"cfc"
	],
	"mappings": {
		"/testbox": "${user-dir}/lib/testbox",
		"/tests": "${user-dir}/tests",
		"/cli": "${user-dir}/cli",
		"/models": "${user-dir}/models",
		"/nanobox": "${user-dir}/"
	},
	"modulesDirectory": [
		"${user-dir}/lib/modules",
		"${boxlang-home}/modules"
	],
	"datasources": {
		"nanobox": {
			"driver": "sqlite",
			"connectionString": "jdbc:sqlite:${user-home}/.nanobox/data/nanobox.db"
		}
	},
	"javaLibraryPaths": [
		"${user-dir}/lib/java"
	]
}
