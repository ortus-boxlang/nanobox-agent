{
	"validTemplateExtensions": [],
	"clearClassFilesOnStartup": true,
	"classResolverCache": true,
	"trustedCache": false,
	"mappings": {
		"/testbox": "${user-dir}/testbox",
		"/tests": "${user-dir}/tests",
		"/nanobox-cli": "${user-dir}/nanobox-cli"
	},
	"modulesDirectory": [
		"${user-dir}/boxlang_modules",
		"${boxlang-home}/modules"
	],
	"datasources": {
		"nanobox": {
			"driver": "sqlite",
			"connectionString": "jdbc:sqlite:${user-dir}/data/nanobox.db"
		}
	}
}
