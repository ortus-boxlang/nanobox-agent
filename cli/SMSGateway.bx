class extends="cli.BaseGateway" {
	function init( struct config = {} ) { super.init( "sms", arguments.config ); return this }
	struct function capabilities() { return { text: true, attachments: false, images: false, audio: false, video: false, reactions: false, threads: false, buttons: false, hitl: true, hitlModes: [ "web" ], hitlMode: "web", hitlDecision: "suspend-resume" } }
}
