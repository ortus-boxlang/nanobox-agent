/**
 * SkillCuratorCommand — CLI interface for the NanoBox skill lifecycle curator.
 *
 * Exposes curator operations (status, run/prune, pin, unpin, mode, archive,
 * restore, backup, rollback, pause, resume, list-archived) through the
 * injected SkillCurator and CuratorReportManager.
 *
 * @author Ortus Solutions
 * @version 0.1.0
 * @since 0.1.0
 */
class {
	property curator;
	property reports;
	property config;

	/**
	 * @skillCurator    SkillCurator instance that drives lifecycle decisions
	 * @reportManager   Optional CuratorReportManager; a default instance is created if omitted
	 * @configManager   Optional ConfigManager for reading the curator model setting
	 */
	function init( required any skillCurator, any reportManager = null, any configManager = null ) { variables.curator = arguments.skillCurator; variables.reports = arguments.reportManager ?: new "models.skills.CuratorReportManager"( expandPath( "." ) ); variables.config = arguments.configManager; return this }

	/**
	 * Dispatches a curator action.
	 *
	 * Supported actions: status, run, pin, unpin, mode, archive, restore, backup,
	 * rollback, pause, resume, list-archived, prune.
	 *
	 * @action  Action name (case-insensitive)
	 * @args    Action arguments (name, dryRun, staleAfterDays, archiveAfterDays, mode, id, reason)
	 * @return  Result struct with success flag and action-specific payload
	 */
	struct function execute( required string action, struct args = {} ) {
		switch ( lCase( arguments.action ) ) {
			case "status": return variables.curator.status()
			case "run": var result = variables.curator.run( arguments.args.dryRun ?: arguments.args[ "dry-run" ] ?: false, val( arguments.args.staleAfterDays ?: arguments.args[ "stale-after-days" ] ?: 30 ), val( arguments.args.archiveAfterDays ?: arguments.args[ "archive-after-days" ] ?: 90 ) ); return variables.reports.write( result, variables.config != null ? variables.config.get( "bx-ai.curatorModel", "" ) : "" )
			case "pin": return variables.curator.pin( arguments.args.name ?: "", true )
			case "unpin": return variables.curator.pin( arguments.args.name ?: "", false )
			case "mode": return variables.curator.setMode( arguments.args.name ?: "", arguments.args.mode ?: "lazy" )
			case "archive": return variables.curator.archive( arguments.args.name ?: "" )
			case "restore": return variables.curator.restore( arguments.args.name ?: "" )
			case "backup": return variables.curator.backup( arguments.args.reason ?: "manual" )
			case "rollback": return variables.curator.rollback( arguments.args.id ?: "" )
			case "pause": return variables.curator.pause( true )
			case "resume": return variables.curator.pause( false )
			case "list-archived": return { success: true, skills: directoryExists( expandPath( ".agents/skills-archive" ) ) ? directoryList( expandPath( ".agents/skills-archive" ), false, "query" ) : [] }
			case "prune": var prune = variables.curator.run( false, val( arguments.args.staleAfterDays ?: 30 ), val( arguments.args.archiveAfterDays ?: 90 ) ); return variables.reports.write( prune, variables.config != null ? variables.config.get( "bx-ai.curatorModel", "" ) : "" )
			default: return { success: false, error: "Unknown curator action: #arguments.action#" }
		}
	}
}
