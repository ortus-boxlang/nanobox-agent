/**
 * ChatCommand — executes a single-turn AI chat request.
 *
 * Resolves the provider and model from the active configuration (supporting
 * named models, explicit overrides, and defaults), then calls aiChat() and
 * returns the response.  Token usage is available on the returned struct.
 *
 * @author Ortus Solutions
 * @version 0.1.0
 * @since 0.1.0
 */
class {
	property configManager;
	property tokenTracker;
	property securityMiddleware;
	property osToolMiddleware;

	/**
	 * @appConfig         ConfigManager instance for provider/model resolution
	 * @usageTracker      TokenTracker instance for recording usage
	 * @secretPatterns    Optional array of regex patterns for secret detection (defaults to common API key formats)
	 * @blockedTools      Optional array of tool names to block (empty means no tools blocked)
	 * @allowlistPath     Optional path to OsToolMiddleware allowlist JSON file
	 * @requireApproval   When true, dangerous OS tool calls require user approval (default: true)
	 */
	function init( required any appConfig, required any usageTracker, array secretPatterns = [], array blockedTools = [], string allowlistPath = "", boolean requireApproval = true ) {
		variables.configManager = arguments.appConfig
		variables.tokenTracker = arguments.usageTracker
		variables.securityMiddleware = new "models.middleware.SecurityMiddleware"( arguments.secretPatterns, arguments.blockedTools )
		variables.osToolMiddleware = new "models.middleware.OsToolMiddleware"( arguments.allowlistPath, arguments.requireApproval )
		return this
	}

	/**
	 * Executes a chat query and returns the AI response.
	 *
	 * Supports per-request overrides for temperature, max_tokens, provider,
	 * model, and named models.  On success the returned struct contains content,
	 * provider, serviceProvider, model, namedModel, usage, and raw keys.
	 * Token usage is recorded via the injected TokenTracker.
	 *
	 * @query    User prompt text; must be non-empty
	 * @options  Optional overrides: provider, model, namedModel, temperature, max_tokens, sessionId
	 * @return   Struct with success flag, content, provider, model, and error keys
	 */
	struct function execute( required string query, struct options = {} ) {
		if ( !len( trim( arguments.query ) ) ) { return { success: false, error: "A query is required" } }
		var selection = resolveModel( arguments.options )
		if ( !selection.success ) { return selection }
		var params = duplicate( selection.options ); params.model = selection.model
		if ( structKeyExists( arguments.options, "temperature" ) ) { params.temperature = arguments.options.temperature }
		if ( structKeyExists( arguments.options, "max_tokens" ) ) { params.max_tokens = arguments.options.max_tokens }
		var providerConfig = variables.configManager.get( "bx-ai.providers.#selection.provider#", {} )
		var serviceProvider = selection.provider
		var providerOptions = duplicate( providerConfig.options ?: {} )
		if ( isStruct( providerConfig ) && lCase( providerConfig.type ?: "" ) == "openai-compatible" ) { serviceProvider = "openai-compatible" }
		if ( isStruct( providerConfig ) && providerConfig.keyExists( "baseURL" ) ) { providerOptions.baseURL = providerConfig.baseURL }
		if ( isStruct( providerConfig ) && providerConfig.keyExists( "apiKey" ) ) { providerOptions.apiKey = providerConfig.apiKey }
		providerOptions.provider = serviceProvider; providerOptions[ "returnFormat" ] = "single"
		// Run SecurityMiddleware beforeLLMCall to check for secrets in the query
		var llmContext = { messages: arguments.query }
		var securityResult = variables.securityMiddleware.beforeLLMCall( llmContext )
		if ( !securityResult.continue ) { return { success: false, error: securityResult.message, provider: selection.provider, serviceProvider: serviceProvider, model: selection.model, namedModel: selection.namedModel } }

		// Run OsToolMiddleware beforeToolCall (no-op if no tool calls, but ensures safety)
		var toolContext = { toolName: "", toolArgs: {} }
		var osResult = variables.osToolMiddleware.beforeToolCall( toolContext )
		if ( !osResult.continue ) {
			if ( osResult.suspended ) {
				return { success: false, error: "Approval required: " & osResult.question, suspended: true, toolName: osResult.toolName, toolArgs: osResult.toolArgs, provider: selection.provider, serviceProvider: serviceProvider, model: selection.model, namedModel: selection.namedModel }
			}
			return { success: false, error: osResult.message, provider: selection.provider, serviceProvider: serviceProvider, model: selection.model, namedModel: selection.namedModel }
		}

		try {
			var response = aiChat( arguments.query, params, providerOptions )
			var content = isStruct( response ) ? ( response.content ?: "" ) : response

			// Run SecurityMiddleware afterAgentRun to check response for leaked secrets
			var responseContext = { response: content }
			var postSecurityResult = variables.securityMiddleware.afterAgentRun( responseContext )
			if ( !postSecurityResult.continue ) {
				return { success: false, error: postSecurityResult.message, provider: selection.provider, serviceProvider: serviceProvider, model: selection.model, namedModel: selection.namedModel }
			}

			// Record token usage via TokenTracker
			var usageData = {}
			if ( isStruct( response ) && response.keyExists( "usage" ) ) {
				usageData = response.usage
			}
			var sessionId = arguments.options.sessionId ?: ""
			variables.tokenTracker.record( usageData, selection.provider, selection.model, "chat", sessionId )

			return { success: true, content: content, provider: selection.provider, serviceProvider: serviceProvider, model: selection.model, namedModel: selection.namedModel, usage: usageData, raw: response }
		} catch ( any exception ) { return { success: false, error: exception.message ?: toString( exception ), provider: selection.provider, serviceProvider: serviceProvider, model: selection.model, namedModel: selection.namedModel } }
	}

	/**
	 * Resolves the effective provider and model for a request.
	 *
	 * Resolution order: named model config → per-request override → default config.
	 * Returns an error struct when the provider or model cannot be determined.
	 *
	 * @options  Request options that may contain provider, model, or namedModel keys
	 * @return   Struct with success, provider, model, options, and namedModel keys
	 */
	private struct function resolveModel( struct options ) {
		var named = arguments.options.namedModel ?: arguments.options[ "named-model" ] ?: variables.configManager.get( "bx-ai.defaultNamedModel", "" )
		if ( len( named ) ) { var namedConfig = variables.configManager.get( "bx-ai.namedModels.#named#", {} ); if ( structIsEmpty( namedConfig ) ) { return { success: false, error: "Named model not found: #named#" } }; return { success: true, provider: namedConfig.provider, model: namedConfig.model, options: namedConfig.options ?: {}, namedModel: named } }
		var provider = arguments.options.provider ?: variables.configManager.get( "bx-ai.defaultProvider", "" )
		var model = arguments.options.model ?: variables.configManager.get( "bx-ai.defaultModel", "" )
		if ( !len( provider ) ) { return { success: false, error: "No AI provider configured. Run nanobox model setup or config provider add." } }
		if ( !len( model ) ) { return { success: false, error: "No model configured. Run nanobox model setup or select a named model." } }
		return { success: true, provider: provider, model: model, options: {}, namedModel: "" }
	}
}
