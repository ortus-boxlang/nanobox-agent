class {
	property processes;
	property workerScript;
	function init( required any processManager, string workerScript = "" ) { variables.processes = arguments.processManager; variables.workerScript = arguments.workerScript != "" ? arguments.workerScript : expandPath( "./nanobox-worker.bx" ); return this }
	struct function execute( required string action, struct args = {} ) {
		switch ( lCase( arguments.action ) ) {
			case "start": return start( arguments.args )
			case "stop": return variables.processes.stop( "worker" )
			case "status": return variables.processes.status( "worker" )
			default: return { success: false, error: "Unknown worker action: #arguments.action#" }
		}
	}
	private struct function start( struct args ) {
		if ( !fileExists( variables.workerScript ) ) { return { success: false, error: "Worker script not found", path: variables.workerScript } }
		var commandArgs = [ variables.workerScript, "--worker" ]
		if ( arguments.args.debug ?: false ) { commandArgs.append( "--debug" ) }
		var executable = "/Users/lmajano/.bvm/current/bin/boxlang"
		if ( !fileExists( executable ) ) { executable = "boxlang" }
		return variables.processes.start( "worker", executable, commandArgs )
	}
}
