class {

	property supervisor;

	function init( required any processManager, string projectRoot = "" ) {
		variables.supervisor = new "worker.core.WorkerSupervisor"(
			arguments.processManager,
			len( arguments.projectRoot ) ? arguments.projectRoot : expandPath( "." )
		)
		return this
	}

	struct function execute( required string action, struct args = {} ) {
		switch ( lCase( arguments.action ) ) {
			case "start":   return variables.supervisor.start( arguments.args )
			case "stop":    return variables.supervisor.stop()
			case "restart": return variables.supervisor.restart( arguments.args )
			case "status":  return variables.supervisor.status()
			default:        return { success: false, error: "Unknown worker action: #arguments.action#" }
		}
	}

}
