/**
 * MCPCommand — CLI interface for managing Model Context Protocol (MCP) server connections.
 *
 * Dispatches MCP actions (list, add, add-stdio, start, stop, remove, test) to
 * the injected McpManager.
 *
 * @author Ortus Solutions
 * @version 0.1.0
 * @since 0.1.0
 */
class {
	property manager;

	/**
	 * @mcpManager McpManager instance that owns MCP server registration and lifecycle
	 */
	function init( required any mcpManager ) { variables.manager = arguments.mcpManager; return this }

	/**
	 * Dispatches an MCP action.
	 *
	 * Supported actions: list, add (HTTP), add-stdio, start, stop, remove, test.
	 *
	 * @action  Action name (case-insensitive)
	 * @args    Action arguments (name, url, apiKey, command, commandArgs, env, etc.)
	 * @return  Result struct with success flag and action-specific payload
	 */
	struct function execute( required string action, struct args = {} ) {
		switch ( lCase( arguments.action ) ) {
			case "list": return { success: true, servers: variables.manager.list() }
			case "add": return { success: true, server: variables.manager.add( arguments.args.name ?: "", arguments.args.url ?: "", arguments.args.apiKey ?: "" ) }
			case "add-stdio": return { success: true, server: variables.manager.addStdio( arguments.args.name ?: "", arguments.args.command ?: "", arguments.args.commandArgs ?: [], arguments.args.env ?: {} ) }
			case "start": return variables.manager.start( arguments.args.name ?: "" )
			case "stop": return variables.manager.stop( arguments.args.name ?: "" )
			case "remove": return variables.manager.remove( arguments.args.name ?: "" )
			case "test": return variables.manager.test( arguments.args.name ?: "" )
			default: return { success: false, error: "Unknown MCP action: #arguments.action#" }
		}
	}
}
