/**
 * CronCommand — CLI interface for managing NanoBox scheduled tasks.
 *
 * Dispatches cron task actions (list, create, show, pause, resume, run,
 * delete, stats) to the injected CronManager.
 *
 * @author Ortus Solutions
 * @version 0.1.0
 * @since 0.1.0
 */
class {
	property manager;

	/**
	 * @cronManager CronManager instance that owns task persistence
	 */
	function init( required any cronManager ) { variables.manager = arguments.cronManager; return this }

	/**
	 * Dispatches a cron task action.
	 *
	 * Supported actions: list, create, show, pause, resume, run, delete, stats.
	 *
	 * @action  Action name (case-insensitive)
	 * @args    Action arguments (name, schedule, prompt, group, etc.)
	 * @return  Result struct with success flag and action-specific payload
	 */
	struct function execute( required string action, struct args = {} ) {
		switch ( lCase( arguments.action ) ) {
			case "list": return { success: true, tasks: variables.manager.list( arguments.args.group ?: "" ) }
			case "create": return variables.manager.create( arguments.args.name ?: "", arguments.args.schedule ?: "", arguments.args.prompt ?: "", arguments.args.group ?: "default" )
			case "show": return { success: true, task: variables.manager.show( arguments.args.name ?: "" ) }
			case "pause": return variables.manager.pause( arguments.args.name ?: "" )
			case "resume": return variables.manager.resume( arguments.args.name ?: "" )
			case "run": return variables.manager.run( arguments.args.name ?: "" )
			case "delete": return variables.manager.remove( arguments.args.name ?: "" )
			case "stats": return { success: true, stats: variables.manager.stats() }
			default: return { success: false, error: "Unknown cron action: #arguments.action#" }
		}
	}
}
