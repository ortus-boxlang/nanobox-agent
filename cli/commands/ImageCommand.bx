/**
 * ImageCommand — generates images from text prompts using aiImage().
 *
 * Resolves the provider and model from the active configuration (supporting
 * named models, explicit overrides, and defaults), then calls aiImage() and
 * saves the generated images to disk.
 *
 * @author Ortus Solutions
 * @version 0.1.0
 * @since 0.1.0
 */
class {
	property configManager;

	/**
	 * @appConfig  ConfigManager instance for provider/model resolution
	 */
	function init( required any appConfig ) {
		variables.configManager = arguments.appConfig
		return this
	}

	/**
	 * Executes an image generation request.
	 *
	 * Supports per-request overrides for provider, model, named model, size,
	 * quality, style, and number of images.  On success the returned struct
	 * contains the saved file paths, provider, model, and prompt.
	 *
	 * @prompt   Text description of the image to generate; must be non-empty
	 * @options  Optional overrides: provider, model, namedModel, size, quality, style, n, output
	 * @return   Struct with success flag, paths array, provider, model, prompt, and error keys
	 */
	struct function execute( required string prompt, struct options = {} ) {
		if ( !len( trim( arguments.prompt ) ) ) { return { success: false, error: "A prompt is required" } }
		var selection = resolveModel( arguments.options )
		if ( !selection.success ) { return selection }
		var params = duplicate( selection.options )
		if ( structKeyExists( arguments.options, "size" ) ) { params.size = arguments.options.size }
		if ( structKeyExists( arguments.options, "quality" ) ) { params.quality = arguments.options.quality }
		if ( structKeyExists( arguments.options, "style" ) ) { params.style = arguments.options.style }
		if ( structKeyExists( arguments.options, "n" ) ) { params.n = val( arguments.options.n ) }
		var providerConfig = variables.configManager.get( "bx-ai.providers.#selection.provider#", {} )
		var serviceProvider = selection.provider
		var providerOptions = duplicate( providerConfig.options ?: {} )
		if ( isStruct( providerConfig ) && lCase( providerConfig.type ?: "" ) == "openai-compatible" ) { serviceProvider = "openai-compatible" }
		if ( isStruct( providerConfig ) && providerConfig.keyExists( "baseURL" ) ) { providerOptions.baseURL = providerConfig.baseURL }
		if ( isStruct( providerConfig ) && providerConfig.keyExists( "apiKey" ) ) { providerOptions.apiKey = providerConfig.apiKey }
		providerOptions.provider = serviceProvider

		try {
			var response = aiImage( arguments.prompt, params, providerOptions )
			var outputDir = arguments.options.output ?: getDefaultOutputDirectory()
			if ( !directoryExists( outputDir ) ) { directoryCreate( outputDir ) }
			var paths = []
			if ( isStruct( response ) && response.keyExists( "saveAllToDirectory" ) ) {
				paths = response.saveAllToDirectory( outputDir )
			} else if ( isStruct( response ) && response.keyExists( "saveToFile" ) ) {
				var fileName = "image_#dateTimeFormat( now(), 'yyyymmdd_HHnnss' )#.png"
				var filePath = outputDir & "/" & fileName
				response.saveToFile( filePath )
				paths.append( filePath )
			} else {
				return { success: false, error: "Unexpected response format from aiImage()", provider: selection.provider, model: selection.model, prompt: arguments.prompt }
			}
			return { success: true, paths: paths, provider: selection.provider, serviceProvider: serviceProvider, model: selection.model, namedModel: selection.namedModel, prompt: arguments.prompt, count: paths.len() }
		} catch ( any exception ) { return { success: false, error: exception.message ?: toString( exception ), provider: selection.provider, serviceProvider: serviceProvider, model: selection.model, namedModel: selection.namedModel, prompt: arguments.prompt } }
	}

	/**
	 * Resolves the effective provider and model for an image generation request.
	 *
	 * Resolution order: named model config → per-request override → default config.
	 * Returns an error struct when the provider or model cannot be determined.
	 *
	 * @options  Request options that may contain provider, model, or namedModel keys
	 * @return   Struct with success, provider, model, options, and namedModel keys
	 */
	private struct function resolveModel( struct options ) {
		var named = arguments.options.namedModel ?: arguments.options[ "named-model" ] ?: variables.configManager.get( "bx-ai.defaultNamedModel", "" )
		if ( len( named ) ) { var namedConfig = variables.configManager.get( "bx-ai.namedModels.#named#", {} ); if ( structIsEmpty( namedConfig ) ) { return { success: false, error: "Named model not found: #named#" } }; return { success: true, provider: namedConfig.provider, model: namedConfig.model, options: namedConfig.options ?: {}, namedModel: named } }
		var provider = arguments.options.provider ?: variables.configManager.get( "bx-ai.defaultProvider", "" )
		var model = arguments.options.model ?: variables.configManager.get( "bx-ai.defaultModel", "" )
		if ( !len( provider ) ) { return { success: false, error: "No AI provider configured. Run nanobox model setup or config provider add." } }
		if ( !len( model ) ) { return { success: false, error: "No model configured. Run nanobox model setup or select a named model.", provider: provider } }
		return { success: true, provider: provider, model: model, options: {}, namedModel: "" }
	}

	/**
	 * Returns the default output directory for generated images.
	 *
	 * Creates the directory if it does not exist. Defaults to ~/Pictures/nanobox/.
	 *
	 * @return  Absolute path to the default output directory
	 */
	private string function getDefaultOutputDirectory() {
		var home = variables.configManager.getNanoboxHome()
		var picturesDir = home & "/Pictures/nanobox"
		if ( !directoryExists( picturesDir ) ) { directoryCreate( picturesDir ) }
		return picturesDir
	}
}
