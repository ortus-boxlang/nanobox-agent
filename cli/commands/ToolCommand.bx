/**
 * ToolCommand — CLI interface for managing NanoBox AI tools.
 *
 * Dispatches tool actions (list, show, enable, disable, status, refresh) to
 * the injected ToolManager.
 *
 * @author Ortus Solutions
 * @version 0.1.0
 * @since 0.1.0
 */
class {
	property manager;

	/**
	 * @toolManager ToolManager instance that owns tool registration and state
	 */
	function init( required any toolManager ) { variables.manager = arguments.toolManager; return this }

	/**
	 * Dispatches a tool action.
	 *
	 * Supported actions: list, show, enable, disable, status, refresh.
	 *
	 * @action  Action name (case-insensitive)
	 * @args    Action arguments (key/name, etc.)
	 * @return  Result struct with success flag and action-specific payload
	 */
	struct function execute( required string action, struct args = {} ) {
		switch ( lCase( arguments.action ) ) {
			case "list": {
				var tools = variables.manager.list()
				var sorted = []
				for ( var key in tools ) {
					tools[ key ].key = key
					sorted.append( tools[ key ] )
				}
				return { success: true, tools: sorted, total: sorted.len() }
			}
			case "show": {
				var key = arguments.args.key ?: arguments.args.name ?: ""
				var found = variables.manager.show( key )
				if ( structIsEmpty( found ) ) { return { success: false, error: "Tool not found: " & key } }
				found.key = key
				return { success: true, tool: found }
			}
			case "enable": return variables.manager.enable( arguments.args.key ?: arguments.args.name ?: "" )
			case "disable": return variables.manager.disable( arguments.args.key ?: arguments.args.name ?: "" )
			case "status": return variables.manager.status()
			case "refresh": return { success: true, index: variables.manager.refresh() }
			default: return { success: false, error: "Unknown tool action: #arguments.action#" }
		}
	}
}
