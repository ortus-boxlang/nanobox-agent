/**
 * SetupOnboarding — interactive terminal UI for the NanoBox setup wizard.
 *
 * Renders coloured boxes, progress bars, prompts, and banners using ANSI
 * 256-color sequences.  Modelled after the BoxLings Terminal class.
 *
 * @author Ortus Solutions
 * @version 0.1.0
 * @since 0.1.0
 */
class {

	property name="ESC";
	property name="RESET";
	property name="BOLD";
	property name="DIM";

	function init() {
		variables.ESC    = char( 27 )
		variables.RESET  = variables.ESC & "[0m"
		variables.BOLD   = variables.ESC & "[1m"
		variables.DIM    = variables.ESC & "[2m"
		return this
	}

	// ── Public helpers ─────────────────────────────────────────────────────

	void function clear() { CLIClear() }

	void function printBold( required string text ) { println( variables.BOLD & arguments.text & variables.RESET ) }

	void function printDim( required string text )  { println( variables.DIM  & arguments.text & variables.RESET ) }

	void function printLine( required string text, any color = "" ) {
		if ( color == "" ) { println( arguments.text ); return }
		println( ansi( color ) & arguments.text & variables.RESET )
	}

	void function print( required string text, any color = "" ) {
		if ( color == "" ) { systemOutput( arguments.text, false ); return }
		systemOutput( ansi( color ) & arguments.text & variables.RESET, false )
	}

	/**
	 * Prints a bordered box with a colored border and indented content.
	 * Each line is prefixed with "│ " and suffixed with " │".
	 */
	void function box( required string title, required array lines, any borderColor = "color75", any titleColor = "color226" ) {
		var maxLen = 0
		for ( var line in arguments.lines ) { maxLen = max( maxLen, len( line ) ) }
		var boxWidth = max( maxLen + 4, len( arguments.title ) + 4 )
		var bc = ansi( arguments.borderColor )
		var tc = ansi( arguments.titleColor )
		// Top border with title
		println( bc & "╭" & repeatString( "─", boxWidth ) & "╮" & variables.RESET )
		println( bc & "│" & variables.RESET & "  " & tc & variables.BOLD & arguments.title & variables.RESET & repeatString( " ", boxWidth - len( arguments.title ) - 2 ) & bc & " │" & variables.RESET )
		println( bc & "│" & variables.RESET & repeatString( " ", boxWidth + 2 ) & bc & "│" & variables.RESET )
		// Content lines
		for ( var line in arguments.lines ) {
			var padding = repeatString( " ", boxWidth - len( line ) )
			println( bc & "│" & variables.RESET & "  " & line & padding & bc & " │" & variables.RESET )
		}
		// Bottom border
		println( bc & "╰" & repeatString( "─", boxWidth ) & "╯" & variables.RESET )
	}

	/**
	 * Prints a full-width banner with colored border and no title.
	 */
	void function banner( required array lines, any borderColor = "color75" ) {
		var maxLen = 0
		for ( var line in arguments.lines ) { maxLen = max( maxLen, len( line ) ) }
		var boxWidth = maxLen + 4
		var bc = ansi( arguments.borderColor )
		println( bc & "╭" & repeatString( "─", boxWidth ) & "╮" & variables.RESET )
		for ( var line in arguments.lines ) {
			var padding = repeatString( " ", boxWidth - len( line ) )
			println( bc & "│" & variables.RESET & "  " & line & padding & bc & " │" & variables.RESET )
		}
		println( bc & "╰" & repeatString( "─", boxWidth ) & "╯" & variables.RESET )
	}

	/**
	 * Prints a gradient banner with the NanoBox logo.
	 */
	void function showNanoBoxLogo() {
		var logo = [
			"███╗   ██╗ █████╗ ███╗   ██╗ ██████╗ ██████╗  ██████╗ ██╗  ██╗",
			"████╗  ██║██╔══██╗████╗  ██║██╔═══██╗██╔══██╗██╔═══██╗╚██╗██╔╝",
			"██╔██╗ ██║███████║██╔██╗ ██║██║   ██║██████╔╝██║   ██║ ╚███╔╝ ",
			"██║╚██╗██║██╔══██║██║╚██╗██║██║   ██║██╔══██╗██║   ██║ ██╔██╗ ",
			"██║ ╚████║██║  ██║██║ ╚████║╚██████╔╝██████╔╝╚██████╔╝██╔╝ ██╗",
			"╚═╝  ╚═══╝╚═╝  ╚═╝╚═╝  ╚═══╝ ╚═════╝ ╚═════╝  ╚═════╝ ╚═╝  ╚═╝"
		]
		var gradient = [ "color81", "color75", "color69", "color63", "color57", "color21" ]
		println( "" )
		for ( var i = 1; i <= logo.len(); i++ ) {
			printLine( "   " & logo[ i ], gradient[ i ] )
		}
		printLine( "            AI Agent Platform · BoxLang", "color248" )
		println( "" )
	}

	/**
	 * Prints a rainbow divider for section breaks.
	 */
	void function rainbowDivider( numeric length = 60 ) {
		var colors = [ 196, 208, 226, 46, 21, 93 ]
		var output = ""
		for ( var i = 1; i <= arguments.length; i++ ) {
			var ci = ( ( i - 1 ) % colors.len() ) + 1
			output &= ansi256( colors[ ci ] ) & "═"
		}
		println( output & variables.RESET )
	}

	/**
	 * Prints a step header with step number and title.
	 */
	void function step( required numeric number, required string title ) {
		println( "" )
		printLine( "  Step #arguments.number#", "color248" )
		box( "Step #arguments.number#: #arguments.title#", [] )
		println( "" )
	}

	/**
	 * Prints a simple horizontal divider.
	 */
	void function divider() {
		printLine( repeatString( "─", 60 ), "color240" )
	}

	/**
	 * Prompts the user for input with a colored prompt string.
	 */
	string function prompt( required string label, string default = "" ) {
		var def = len( arguments.default ) ? " [#arguments.default#]" : ""
		print( "  " & arguments.label & def & ": ", "color226" )
		var input = CLIRead().trim()
		if ( !len( input ) && len( arguments.default ) ) { return arguments.default }
		return input
	}

	/**
	 * Prompts the user to select from a numbered list of options.
	 * Returns the selected value (or the custom input for "Other").
	 */
	string function select( required string label, required array options, boolean allowCustom = true ) {
		println( "  " & arguments.label, "color226" )
		for ( var i = 1; i <= arguments.options.len(); i++ ) {
			var opt = arguments.options[ i ]
			println( "    [#i#] " & opt.label )
			if ( len( opt.description ?: "" ) ) {
				println( "         " & variables.DIM & opt.description & variables.RESET )
			}
		}
		if ( arguments.allowCustom ) {
			println( "    [#arguments.options.len() + 1#] Other (type your own)" )
		}
		print( "  Enter choice (1-#arguments.options.len() + ( allowCustom ? 1 : 0 )#): ", "color226" )
		var input = CLIRead().trim()
		var num = tryParseInt( input )
		if ( !isNull( num ) && num >= 1 && num <= arguments.options.len() ) {
			return arguments.options[ num ].value
		}
		if ( !isNull( num ) && arguments.allowCustom && num == arguments.options.len() + 1 ) {
			print( "  Enter custom value: ", "color226" )
			return CLIRead().trim()
		}
		// If invalid selection but there's text, treat as custom
		if ( arguments.allowCustom && len( input ) ) { return input }
		// Default to first option
		return arguments.options[ 1 ].value
	}

	/**
	 * Yes/no prompt.  Returns true for y/yes.
	 */
	boolean function confirm( required string label, boolean defaultYes = true ) {
		var hint = arguments.defaultYes ? "Y/n" : "y/N"
		print( "  " & arguments.label & " (" & hint & "): ", "color226" )
		var input = CLIRead().trim().lcase()
		if ( !len( input ) ) { return arguments.defaultYes }
		return input == "y" || input == "yes"
	}

	/**
	 * Prints a success message with a green check.
	 */
	void function success( required string message ) {
		printLine( "  ✅ " & arguments.message, "color46" )
	}

	/**
	 * Prints an info message with a blue info icon.
	 */
	void function info( required string message ) {
		printLine( "  ℹ️  " & arguments.message, "color39" )
	}

	/**
	 * Prints an error message with a red cross.
	 */
	void function error( required string message ) {
		printLine( "  ❌ " & arguments.message, "color196" )
	}

	// ── Private helpers ────────────────────────────────────────────────────

	private string function ansi( any colorOrNumber ) {
		if ( isNumeric( colorOrNumber ) ) { return ansi256( colorOrNumber ) }
		switch ( colorOrNumber ) {
			case "red":     return variables.ESC & "[31m"
			case "green":   return variables.ESC & "[32m"
			case "yellow":  return variables.ESC & "[33m"
			case "blue":    return variables.ESC & "[34m"
			case "magenta": return variables.ESC & "[35m"
			case "cyan":    return variables.ESC & "[36m"
			default:        return getColorCode( colorOrNumber )
		}
	}

	private string function ansi256( required numeric code ) {
		return variables.ESC & "[38;5;" & arguments.code & "m"
	}

	private string function getColorCode( required string name ) {
		var num = replaceNoCase( arguments.name, "color", "" )
		return isNumeric( num ) ? ansi256( num ) : variables.RESET
	}

	private numeric function tryParseInt( required string s ) {
		if ( !len( trim( arguments.s ) ) ) { return null }
		return isNumeric( arguments.s ) ? int( arguments.s ) : null
	}

}
