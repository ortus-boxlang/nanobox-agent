/**
 * CommandRuntime — master command router for the NanoBox CLI.
 *
 * Receives a parsed CLI struct from {@code nanobox.bx}, maps the leading positional
 * argument to the appropriate command class, and delegates execution.  All NanoBox
 * subsystems (session, chat, agent, tool, MCP, vault, gateway, etc.) are instantiated
 * here and never cached — each command invocation gets a fresh object graph.
 *
 * @author Ortus Solutions
 * @version 0.1.0
 * @since 0.1.0
 */
class {
	property output;
	property config;
	property home;

	/**
	 * @cliOutput      PrettyCli instance for formatted terminal output
	 * @configManager  ConfigManager providing access to the NanoBox config file
	 */
	function init( required any cliOutput, required any configManager ) {
		variables.output = arguments.cliOutput
		variables.config = arguments.configManager
		variables.home = variables.config.getNanoboxHome()
		return this
	}

	/**
	 * Dispatches the parsed CLI struct to the correct command handler.
	 *
	 * The first positional argument is the command namespace.  A second positional
	 * argument (when present) is the sub-action.  Remaining positionals and options
	 * are normalised by {@link #positionalArguments} and forwarded to the handler.
	 *
	 * @parsed  Struct produced by the CLI argument parser; must have positionals and options keys
	 * @return  Command result struct with at least a success key
	 */
	struct function execute( required struct parsed ) {
		var command = arguments.parsed.positionals.first()
		var action = arguments.parsed.positionals.len() >= 2 ? arguments.parsed.positionals[ 2 ] : ""
		var args = positionalArguments( command, action, arguments.parsed.positionals, arguments.parsed.options ?: {} )
		switch ( command ) {
			case "config":
				if ( action == "provider" ) { return new "models.providers.ProviderCommand"( variables.config ).execute( args.action ?: "list", args ) }
				if ( action == "model" ) { return new "cli.commands.ModelCommand"( variables.config ).execute( args.action ?: "current", args ) }
				return new "cli.commands.ConfigCommand"( variables.config ).execute( action ?: "show", args )
			case "session": return new "cli.commands.SessionCommand"( new "models.sessions.SessionManager"() ).execute( action ?: "list", args )
			case "tokens":
			case "token": return new "cli.commands.TokenCommand"( new "models.util.TokenTracker"() ).execute( action ?: "all", "", false, args )
			case "agent":
			var mwConfig = variables.config.get( "nanobox.middleware", {} )
			return new "cli.commands.AgentCommand"(
				new "models.agents.AgentManager"(
					variables.home & "/agents",
					variables.config,
					mwConfig.secretPatterns ?: [],
					mwConfig.blockedTools ?: [],
					mwConfig.allowlistPath ?: "",
					mwConfig.requireApproval ?: true
				)
			).execute( action ?: "list", args )
			case "tool": return new "cli.commands.ToolCommand"( new "models.tools.ToolManager"( variables.home, variables.config ) ).execute( action ?: "list", args )
			case "mcp": return new "cli.commands.MCPCommand"( new "models.agents.McpManager"() ).execute( action ?: "list", args )
			case "script": return new "cli.commands.ScriptCommand"( new "models.system.ScriptManager"() ).execute( action ?: "list", args )
			case "cron": return new "cli.commands.CronCommand"( new "models.scheduling.CronManager"() ).execute( action ?: "list", args )
			case "backup": return new "cli.commands.BackupCommand"( new "models.system.BackupManager"() ).execute( action ?: "status", args )
			case "update": return new "cli.commands.UpdateCommand"( new "models.system.UpdateManager"() ).execute( action ?: "status", args )
			case "vault": return new "cli.commands.VaultCommand"( new "models.vault.VaultManager"( variables.home & "/vault" ) ).execute( action ?: "list", args )
			case "security": return new "cli.commands.SecurityCommand"( new "models.security.SecurityCzar"() ).execute( action ?: "status", args )
			case "logs":
			case "log": {
				// Handle bare positional as show action: `nanobox logs mylog` -> show mylog
				var logsKnown = [ "list", "show", "tail", "search", "path", "clear" ]
				if ( !logsKnown.contains( lCase( action ) ) ) {
					// First positional after 'logs' is not a known action -> treat as show <name>
					return new "cli.commands.LogCommand"( new "models.system.LogManager"() ).execute( action, args )
				}
				return new "cli.commands.LogCommand"( new "models.system.LogManager"() ).execute( action, args )
			}
			case "setup": return new "cli.commands.SetupCommand"( variables.config ).execute( args.force ?: args[ "force" ] ?: false )
			case "memory": return new "cli.commands.MemoryCommand"( new "models.system.MemoryManager"() ).execute( action ?: "list", args )
			case "image": {
				var imgPrompt = args.prompt ?: args.query ?: arrayToList( parsed.positionals.slice( 2 ), " " )
				return new "cli.commands.ImageCommand"( variables.config ).execute( imgPrompt, args )
			}
			case "speak":
			case "tts": return new "cli.commands.SpeakCommand"( variables.config ).execute( action ?: "speak", args )
			case "web": return wrapProcessResult( new "cli.commands.WebCommand"( new "models.system.ProcessManager"() ).execute( action ?: "status", args ) )
			case "worker": return wrapProcessResult( new "cli.commands.WorkerCommand"( new "models.system.ProcessManager"() ).execute( action ?: "status", args ) )
			case "start":
			case "stop":
			case "restart":
			case "status":
			case "doctor": return new "cli.CoreLifecycleCommand"( variables.config ).execute( command, args )
			case "gateway": return new "cli.commands.GatewayCommand"( new "models.gateway.GatewayRegistry"( variables.config ), variables.config ).execute( action ?: "status", args )
			case "model": return new "cli.commands.ModelCommand"( variables.config ).execute( action ?: "current", args )
			case "browser": return new "cli.commands.BrowserCommand"( variables.config ).execute( action ?: "status", args )
			case "skill":
				if ( action == "curator" ) { return new "cli.commands.SkillCuratorCommand"( new "models.skills.SkillCurator"( expandPath( "." ) ), new "models.skills.CuratorReportManager"( expandPath( "." ), new "models.vault.VaultManager"( expandPath( ".nanobox/vault" ) ), variables.config ), variables.config ).execute( args.action ?: "status", args ) }
				if ( action == "activate" ) { return new "cli.commands.SkillActivationCommand"( new "models.skills.SkillCurator"( expandPath( "." ) ) ).execute( args.action ?: "status", args ) }
				return new "cli.commands.SkillCommand"( new "models.skills.SkillManager"( expandPath( "." ) & "/.agents/skills" ) ).execute( action ?: "list", args )
			case "chat":
				if ( args.z ?: args[ "z" ] ?: false ) { return chat( args.query ?: args.q ?: arrayToList( parsed.positionals.slice( 2 ), " " ), args, true ) }
				if ( !len( args.query ?: args.q ?: "" ) ) { return interactiveChat( arguments.parsed ) }
				return chat( args.query ?: args.q ?: "", args, false )
			default: return { success: false, error: "Unknown command: #command#" }
		}
	}

	/**
	 * Normalises a process-command result so {@code success} reflects whether the process is stopped.
	 *
	 * @result  Raw result struct from WebCommand or WorkerCommand
	 * @return  Result with success set to true when the process status is "stopped"
	 */
	private struct function wrapProcessResult( required struct result ) { arguments.result.success = ( arguments.result.success ?: ( arguments.result.status ?: "stopped" ) == "stopped" ); return arguments.result }

	/**
	 * Extracts named argument values from the positional argument array.
	 *
	 * Each command/action combination has defined positional slots for its required
	 * arguments.  This method maps those slots into named keys on the args struct so
	 * command handlers can use a uniform named-parameter API.
	 *
	 * @command    First positional (command namespace)
	 * @action     Second positional (sub-action)
	 * @positionals Full array of positional arguments from the CLI parser
	 * @options    Named options struct from the CLI parser
	 * @return     Merged args struct combining options and extracted positional values
	 */
	private struct function positionalArguments( required string command, required string action, required array positionals, required struct options ) {
		var result = duplicate( arguments.options )
		var values = arguments.positionals
		if ( arguments.command == "config" && arguments.action == "provider" && values.len() >= 3 && !result.keyExists( "action" ) ) { result.action = values[ 3 ] }
		if ( arguments.command == "config" && arguments.action == "provider" && values.len() >= 4 && !result.keyExists( "name" ) ) { result.name = values[ 4 ] }
		if ( arguments.command == "config" && arguments.action == "model" && values.len() >= 3 && !result.keyExists( "action" ) ) { result.action = values[ 3 ] }
		if ( arguments.command == "config" && arguments.action == "model" && values.len() >= 4 && !result.keyExists( "model" ) ) { result.model = values[ 4 ] }
		if ( arguments.command == "config" && ( arguments.action == "get" || arguments.action == "unset" ) && values.len() >= 3 && !result.keyExists( "key" ) ) { result.key = values[ 3 ] }
		if ( arguments.command == "config" && arguments.action == "set" ) { if ( values.len() >= 3 && !result.keyExists( "key" ) ) { result.key = values[ 3 ] }; if ( values.len() >= 4 && !result.keyExists( "value" ) ) { result.value = values[ 4 ] } }
		if ( arguments.command == "skill" && arguments.action == "activate" && values.len() >= 3 && !result.keyExists( "action" ) ) { result.action = values[ 3 ] }
		if ( arguments.command == "skill" && arguments.action == "activate" && values.len() >= 4 && !result.keyExists( "name" ) ) { result.name = values[ 4 ] }
		if ( arguments.command == "skill" && arguments.action == "curator" && values.len() >= 3 && !result.keyExists( "action" ) ) { result.action = values[ 3 ] }
		if ( arguments.command == "skill" && arguments.action == "curator" && values.len() >= 4 && !result.keyExists( "name" ) ) { result.name = values[ 4 ] }
		if ( arguments.command == "skill" && arguments.action == "curator" && values.len() >= 5 && !result.keyExists( "mode" ) ) { result.mode = values[ 5 ] }
		if ( arguments.command == "skill" && arguments.action == "curator" && values.len() >= 4 && !result.keyExists( "id" ) ) { result.id = values[ 4 ] }
		if ( arguments.command == "skill" && values.len() >= 3 && !result.keyExists( "name" ) && [ "show", "create", "remove" ].contains( arguments.action ) ) { result.name = values[ 3 ] }
		if ( arguments.command == "skill" && values.len() >= 3 && !result.keyExists( "query" ) && arguments.action == "search" ) { result.query = arrayToList( values.slice( 3 ), " " ) }
		if ( arguments.command == "skill" && arguments.action == "find" && values.len() >= 3 && !result.keyExists( "query" ) ) { result.query = arrayToList( values.slice( 3 ), " " ) }
		if ( arguments.command == "skill" && arguments.action == "install" && values.len() >= 3 && !result.keyExists( "slug" ) ) { result.slug = values[ 3 ] }
		if ( arguments.command == "memory" && [ "show", "delete" ].contains( arguments.action ) && values.len() >= 3 && !result.keyExists( "id" ) ) { result.id = values[ 3 ] }
		if ( arguments.command == "memory" && arguments.action == "add" ) { if ( values.len() >= 3 && !result.keyExists( "topic" ) ) { result.topic = values[ 3 ] }; if ( values.len() >= 4 && !result.keyExists( "entry" ) ) { result.entry = arrayToList( values.slice( 4 ), " " ) } }
		if ( arguments.command == "memory" && arguments.action == "search" && values.len() >= 3 && !result.keyExists( "query" ) ) { result.query = arrayToList( values.slice( 3 ), " " ) }
		if ( arguments.command == "vault" && values.len() >= 3 && !result.keyExists( "id" ) ) { result.id = values[ 3 ] }
		if ( arguments.command == "vault" && arguments.action == "import" && values.len() >= 3 && !result.keyExists( "source" ) ) { result.source = values[ 3 ] }
		if ( arguments.command == "vault" && arguments.action == "search" && values.len() >= 3 && !result.keyExists( "query" ) ) { result.query = arrayToList( values.slice( 3 ), " " ) }
		if ( arguments.command == "agent" && arguments.action == "run" && values.len() >= 3 && !result.keyExists( "name" ) ) { result.name = values[ 3 ] }
		if ( arguments.command == "agent" && arguments.action == "run" && values.len() >= 4 && !result.keyExists( "query" ) ) { result.query = arrayToList( values.slice( 4 ), " " ) }
		if ( arguments.command == "agent" && ( arguments.action == "show" || arguments.action == "delete" || arguments.action == "update" ) && values.len() >= 3 && !result.keyExists( "name" ) ) { result.name = values[ 3 ] }
		if ( arguments.command == "agent" && arguments.action == "create" && values.len() >= 3 && !result.keyExists( "name" ) ) { result.name = values[ 3 ] }
		if ( arguments.command == "agent" && arguments.action == "create" && values.len() >= 4 && !result.keyExists( "instructions" ) ) { result.instructions = arrayToList( values.slice( 4 ), " " ) }
		if ( arguments.command == "session" && values.len() >= 3 && !result.keyExists( "id" ) ) { result.id = values[ 3 ] }
		if ( arguments.command == "session" && arguments.action == "create" ) { if ( values.len() >= 3 && !result.keyExists( "title" ) ) { result.title = arrayToList( values.slice( 3 ), " " ) }; result.nonInteractive = true }
		if ( arguments.command == "session" && arguments.action == "search" && values.len() >= 3 && !result.keyExists( "query" ) ) { result.query = arrayToList( values.slice( 3 ), " " ) }
		if ( arguments.command == "session" && arguments.action == "rename" && values.len() >= 3 && !result.keyExists( "id" ) ) { result.id = values[ 3 ] }
		if ( arguments.command == "session" && arguments.action == "rename" && values.len() >= 4 && !result.keyExists( "title" ) ) { result.title = arrayToList( values.slice( 4 ), " " ) }
		if ( arguments.command == "session" && arguments.action == "export" && values.len() >= 3 && !result.keyExists( "id" ) ) { result.id = values[ 3 ] }
		if ( arguments.command == "session" && arguments.action == "delete" && values.len() >= 3 && !result.keyExists( "id" ) ) { result.id = values[ 3 ] }
		if ( arguments.command == "chat" && arguments.action == "chat" && values.len() >= 3 && !result.keyExists( "query" ) ) { result.query = values[ 3 ] }
		if ( arguments.command == "chat" && values.len() >= 2 && !result.keyExists( "query" ) ) { result.query = arrayToList( values.slice( 2 ), " " ) }
		if ( arguments.command == "chat" && values.len() >= 2 && !result.keyExists( "z" ) && values[ 2 ] == "-z" ) { result.z = true; result.query = values.len() >= 3 ? arrayToList( values.slice( 3 ), " " ) : "" }
		if ( arguments.command == "model" && arguments.action == "status" && values.len() >= 3 && !result.keyExists( "provider" ) ) { result.provider = values[ 3 ] }
		if ( arguments.command == "model" && arguments.action == "curator" && values.len() >= 3 && !result.keyExists( "namedModel" ) ) { result.namedModel = values[ 3 ] }
		if ( arguments.command == "model" && arguments.action == "remove" && values.len() >= 3 && !result.keyExists( "name" ) ) { result.name = values[ 3 ] }
		if ( arguments.command == "model" && arguments.action == "add" && values.len() >= 3 && !result.keyExists( "name" ) ) { result.name = values[ 3 ] }
		if ( arguments.command == "tool" && ( arguments.action == "show" || arguments.action == "remove" ) && values.len() >= 3 && !result.keyExists( "name" ) ) { result.name = values[ 3 ] }
		if ( arguments.command == "tool" && arguments.action == "create" && values.len() >= 3 && !result.keyExists( "name" ) ) { result.name = values[ 3 ] }
		if ( arguments.command == "tool" && ( arguments.action == "enable" || arguments.action == "disable" ) && values.len() >= 3 && !result.keyExists( "key" ) ) { result.key = values[ 3 ] }
		if ( arguments.command == "tool" && arguments.action == "show" && values.len() >= 3 && !result.keyExists( "key" ) ) { result.key = values[ 3 ] }
		if ( arguments.command == "model" && ( arguments.action == "set" || arguments.action == "setup" || arguments.action == "configure" ) && values.len() >= 3 && !result.keyExists( "model" ) ) { result.model = values[ 3 ] }
		if ( arguments.command == "model" && ( arguments.action == "setup" || arguments.action == "configure" ) && values.len() >= 3 && !result.keyExists( "provider" ) ) { result.provider = values[ 3 ] }
		if ( arguments.command == "model" && ( arguments.action == "setup" || arguments.action == "configure" ) && values.len() >= 4 && !result.keyExists( "model" ) ) { result.model = values[ 4 ] }
		if ( arguments.command == "vault" && arguments.action == "import" && values.len() >= 3 && !result.keyExists( "path" ) ) { result.path = values[ 3 ] }
		if ( arguments.command == "vault" && arguments.action == "import" && options.keyExists( "tags" ) ) { result.tags = options.tags }
		if ( arguments.command == "vault" && arguments.action == "import" && options.keyExists( "category" ) ) { result.category = options.category }
		if ( arguments.command == "gateway" && arguments.action == "send" ) { if ( values.len() >= 4 && !result.keyExists( "recipient" ) ) { result.recipient = values[ 4 ] }; if ( values.len() >= 5 && !result.keyExists( "message" ) ) { result.message = values[ 5 ] } }
		if ( arguments.command == "gateway" && arguments.action == "broadcast" ) { if ( values.len() >= 3 && !result.keyExists( "recipient" ) ) { result.recipient = values[ 3 ] }; if ( values.len() >= 4 && !result.keyExists( "message" ) ) { result.message = values[ 4 ] } }
		if ( [ "speak", "tts" ].contains( arguments.command ) && values.len() >= 2 && !result.keyExists( "text" ) ) { result.text = arrayToList( values.slice( 2 ), " " ) }
		if ( arguments.command == "image" && values.len() >= 2 && !result.keyExists( "prompt" ) ) { result.prompt = arrayToList( values.slice( 2 ), " " ) }
		if ( result.keyExists( "token-env" ) ) { result.tokenEnv = result[ "token-env" ] }
		return result
	}

	/**
	 * Starts or stops the web server and worker processes together.
	 *
	 * @action  "start", "stop", or "restart"
	 * @args    Optional named arguments forwarded to sub-commands
	 * @return  Struct with success flag and nested web and worker result keys
	 */
	private struct function processAction( required string action, struct args = {} ) {
		var manager = new "models.system.ProcessManager"()
		var web = new "cli.commands.WebCommand"( manager )
		var worker = new "cli.commands.WorkerCommand"( manager )
		if ( arguments.action == "stop" ) { return { success: true, web: web.execute( "stop", arguments.args ), worker: worker.execute( "stop", arguments.args ) } }
		if ( arguments.action == "restart" ) { processAction( "stop", arguments.args ) }
		return { success: true, web: web.execute( "start", arguments.args ), worker: worker.execute( "start", arguments.args ) }
	}

	/**
	 * Returns a diagnostic struct confirming core NanoBox components are reachable.
	 *
	 * @return Struct with config file existence, home path, datasource name, and required module names
	 */
	private struct function doctor() { return { success: true, config: fileExists( variables.config.getConfigPath() ), home: variables.home, datasource: "nanobox", modules: [ "bx-ai", "bx-sqlite" ] } }

	/**
	 * Delegates vault list, search, or index operations to VaultManager.
	 *
	 * @action  "search", "index", or default (list)
	 * @args    Named arguments (query, category)
	 * @return  Vault operation result
	 */
	private struct function vault( required string action, struct args = {} ) {
		var manager = new "models.vault.VaultManager"()
		if ( arguments.action == "search" ) { return { success: true, documents: manager.search( arguments.args.query ?: "" ) } }
		if ( arguments.action == "index" ) { return manager.index() }
		return { success: true, documents: manager.list( arguments.args.category ?: "" ) }
	}


	/**
	 * Delegates model get/set operations to ConfigManager.
	 *
	 * @action  "set", "current", or default (list models)
	 * @args    Named arguments (model, name)
	 * @return  Model operation result
	 */
	private struct function model( required string action, struct args = {} ) {
		if ( arguments.action == "set" ) { variables.config.set( "bx-ai.defaultModel", arguments.args.model ?: arguments.args.name ?: "" ); return { success: true, model: variables.config.get( "bx-ai.defaultModel" ) } }
		if ( arguments.action == "current" ) { return { success: true, provider: variables.config.get( "bx-ai.defaultProvider" ), model: variables.config.get( "bx-ai.defaultModel" ) } }
		return { success: true, models: variables.config.get( "bx-ai.models", [] ) }
	}

	/**
	 * Returns a directory listing of the NanoBox home skills directory.
	 *
	 * @action  Ignored; reserved for future sub-commands
	 * @args    Ignored
	 * @return  Struct with success and skills listing
	 */
	private struct function skills( required string action, struct args = {} ) { var path = variables.home & "/skills"; var items = directoryExists( path ) ? directoryList( path, false, "query" ) : []; return { success: true, skills: items } }

	/**
	 * Executes a single-shot (non-interactive) chat query.
	 *
	 * @query     User prompt text
	 * @args      Optional named arguments forwarded to ChatCommand
	 * @textOnly  When true, strips all keys except success and text from the result
	 * @return    ChatCommand result, optionally reduced to {success, text}
	 */
	private struct function chat( required string query, struct args = {}, boolean textOnly = false ) {
		var mwConfig = variables.config.get( "nanobox.middleware", {} )
		var result = new "cli.commands.ChatCommand"(
			variables.config,
			new "models.util.TokenTracker"(),
			new "models.sessions.SessionManager"(),
			mwConfig.secretPatterns ?: [],
			mwConfig.blockedTools ?: [],
			mwConfig.allowlistPath ?: "",
			mwConfig.requireApproval ?: true
		).execute( arguments.query, arguments.args )
		if ( arguments.textOnly ) { return { success: result.success, text: result.content ?: "", error: result.error ?: "" } }
		return result
	}

	/**
	 * Starts the interactive REPL chat session.
	 *
	 * Attempts to launch the full three-panel Lanterna TUI (header, session sidebar, chat
	 * area, input bar).  Falls back gracefully to a plain ANSI loop when Lanterna is
	 * unavailable (JAR missing, headless environment, piped output, etc.).
	 *
	 * Lanterna event loop handles:
	 *   - Printable chars  → appended to input buffer, input bar redrawn
	 *   - Backspace        → removes last character, input bar redrawn
	 *   - Enter            → dispatches to InteractiveChat, chat panel redrawn
	 *   - Tab              → toggles focus between sidebar and input
	 *   - ArrowUp/Down     → moves sidebar session cursor (when sidebar has focus)
	 *   - Escape           → returns focus from sidebar to input
	 *   - Ctrl+C / EOF     → exits cleanly (stopScreen before returning)
	 *
	 * @parsed  Full parsed CLI struct
	 * @return  Struct with success flag, interactive=true, and sessionId
	 */
	private struct function interactiveChat( struct parsed = {} ) {
		var mwConfig  = variables.config.get( "nanobox.middleware", {} )
		var tuiConfig = variables.config.get( "nanobox.tui", {} )

		// ── Build ChatCommand ──────────────────────────────────────────────
		var chatCommand = new "cli.commands.ChatCommand"(
			variables.config,
			new "models.util.TokenTracker"(),
			new "models.sessions.SessionManager"(),
			mwConfig.secretPatterns ?: [],
			mwConfig.blockedTools ?: [],
			mwConfig.allowlistPath ?: "",
			mwConfig.requireApproval ?: true
		)

		// ── Build InteractiveChat + inject slash-command dependencies ──────
		var interactive = new "cli.InteractiveChat"( chatCommand, new "models.sessions.SessionManager"(), variables.config )
		try {
			interactive.setCommands( {
				agentCommand:   new "cli.commands.AgentCommand"(
									new "models.agents.AgentManager"(
										variables.home & "/agents",
										variables.config,
										mwConfig.secretPatterns ?: [],
										mwConfig.blockedTools ?: [],
										mwConfig.allowlistPath ?: "",
										mwConfig.requireApproval ?: true
									)
								),
				memoryCommand:  new "cli.commands.MemoryCommand"( new "models.system.MemoryManager"() ),
				skillCommand:   new "cli.commands.SkillCommand"( new "models.skills.SkillManager"( variables.home & "/.agents/skills" ) ),
				vaultCommand:   new "cli.commands.VaultCommand"( new "models.vault.VaultManager"( variables.home & "/vault" ) ),
				sessionCommand: new "cli.commands.SessionCommand"( new "models.sessions.SessionManager"() ),
				mcpCommand:     new "cli.commands.MCPCommand"( new "models.agents.McpManager"() ),
				tokenCommand:   new "cli.commands.TokenCommand"( new "models.util.TokenTracker"() ),
				modelCommand:   new "cli.commands.ModelCommand"( variables.config ),
				cronCommand:    new "cli.commands.CronCommand"( new "models.scheduling.CronManager"() )
			} )
		} catch ( any e ) {
			// Non-fatal — slash commands that need these classes will report "not available"
		}

		var started = interactive.start( true )

		// ── Load TUI theme ─────────────────────────────────────────────────
		var tuiTheme = new "cli.TuiTheme"()
		var theme    = tuiTheme.current( variables.config )
		var wrapWidth = val( tuiConfig.wrapWidth ?: 0 )

		// ── Attempt Lanterna startup ───────────────────────────────────────
		var screen      = new "cli.LanternaScreen"()
		var useLanterna = false
		try {
			screen.startScreen()
			useLanterna = true
		} catch ( any e ) {
			// Headless or JAR missing — ANSI fallback below
		}

		var renderer = new "cli.InteractiveChatRenderer"( interactive, theme, useLanterna ? screen : null, wrapWidth )

		// ══════════════════════════════════════════════════════════════════
		// LANTERNA EVENT LOOP
		// ══════════════════════════════════════════════════════════════════
		if ( useLanterna ) {
			try {
				var sessMgr    = new "models.sessions.SessionManager"()
				var sessions   = []
				try { sessions = sessMgr.list( 10, 0 ) } catch ( any e ) {}

				var state = {
					title:            started.title,
					provider:         variables.config.get( "bx-ai.defaultProvider", "" ),
					model:            variables.config.get( "bx-ai.defaultModel", "" ),
					namedModel:       variables.config.get( "bx-ai.defaultNamedModel", "" ),
					sessions:         sessions,
					currentSessionId: started.sessionId,
					sidebarCursor:    0,
					sidebarFocus:     false,
					sidebarVisible:   true,
					messages:         [],
					inputBuffer:      "",
					cursorPos:        0,
					usage:            { requests: 0, inputTokens: 0, outputTokens: 0, totalTokens: 0 }
				}

				renderer.renderAll( state )

				var inputBuffer    = ""
				var sidebarFocus   = false
				var sidebarCursor  = 0
				var sidebarVisible = true

				while ( true ) {
					var key = screen.readInput()

					// ── Exit ───────────────────────────────────────────────
					if ( key.type == "EOF" || ( key.type == "Character" && key.character == "c" && key.ctrl ) ) {
						break
					}

					// ── Ctrl+B — toggle sidebar visibility (works from either focus) ──
					if ( key.type == "Character" && key.character == "b" && key.ctrl ) {
						sidebarVisible         = !sidebarVisible
						state.sidebarVisible   = sidebarVisible
						if ( !sidebarVisible && sidebarFocus ) {
							sidebarFocus       = false
							state.sidebarFocus = false
						}
						renderer.renderAll( state )
						continue
					}

					// ── Sidebar focus: arrow navigation + Enter to resume ──
					if ( sidebarFocus ) {
						if ( key.type == "ArrowUp" && sidebarCursor > 0 ) {
							sidebarCursor--
							state.sidebarCursor = sidebarCursor
							renderer.renderAll( state )
						} else if ( key.type == "ArrowDown" && sidebarCursor < state.sessions.len() - 1 ) {
							sidebarCursor++
							state.sidebarCursor = sidebarCursor
							renderer.renderAll( state )
						} else if ( key.type == "Enter" && state.sessions.len() > 0 ) {
							var sel = state.sessions[ sidebarCursor + 1 ]
							try {
								var resumeResp = interactive.execute( "/resume " & sel.id )
								state.currentSessionId = sel.id
								state.title            = sel.title ?: state.title
								state.messages         = []
								state.usage            = { requests: 0, inputTokens: 0, outputTokens: 0, totalTokens: 0 }
							} catch ( any e ) {}
							sidebarFocus       = false
							state.sidebarFocus = false
							renderer.renderAll( state )
						} else if ( key.type == "Escape" || key.type == "Tab" ) {
							sidebarFocus       = false
							state.sidebarFocus = false
							renderer.renderAll( state )
						}
						continue
					}

					// ── Input focus: typing ────────────────────────────────
					if ( key.type == "Tab" && sidebarVisible ) {
						sidebarFocus       = true
						state.sidebarFocus = true
						renderer.renderAll( state )

					} else if ( key.type == "Character" && !key.ctrl && !key.alt ) {
						inputBuffer      &= key.character
						state.inputBuffer = inputBuffer
						state.cursorPos   = len( inputBuffer )
						renderer.renderInputOnly( state )

					} else if ( key.type == "Backspace" ) {
						if ( len( inputBuffer ) > 0 ) {
							inputBuffer      = left( inputBuffer, len( inputBuffer ) - 1 )
							state.inputBuffer = inputBuffer
							state.cursorPos   = len( inputBuffer )
							renderer.renderInputOnly( state )
						}

					} else if ( key.type == "Enter" ) {
						var userInput = trim( inputBuffer )
						inputBuffer      = ""
						state.inputBuffer = ""
						state.cursorPos   = 0

						if ( !len( userInput ) ) { continue }

						// Optimistic: show user turn + thinking placeholder
						state.messages.append( { role: "user", content: userInput } )
						state.messages.append( { role: "assistant", content: "  ⠙  Thinking…" } )
						renderer.renderChatOnly( state )

						// Dispatch (blocking)
						var response = interactive.execute( userInput )

						// Replace placeholder with real content
						var lastIdx = state.messages.len()
						if ( response.exit ?: false ) { break }
						if ( response.action == "response" ) {
							state.messages[ lastIdx ] = { role: "assistant", content: response.content ?: "" }
						} else if ( response.action == "empty" ) {
							state.messages.deleteAt( lastIdx )
							state.messages.deleteAt( state.messages.len() )
						} else {
							state.messages[ lastIdx ] = { role: "command", action: response.action ?: "result", result: response }
						}

						// Refresh usage + session list
						if ( isStruct( response.usage ?: "" ) ) { state.usage = response.usage }
						state.title = interactive.getTitle() ?: state.title
						try { state.sessions = sessMgr.list( 10, 0 ) } catch ( any e ) {}

						renderer.renderChatOnly( state )
					}
				}
			} finally {
				screen.stopScreen()
			}

		// ══════════════════════════════════════════════════════════════════
		// ANSI FALLBACK LOOP
		// ══════════════════════════════════════════════════════════════════
		} else {
			println( renderer.renderHeader( {
				title:      started.title,
				provider:   variables.config.get( "bx-ai.defaultProvider", "" ),
				model:      variables.config.get( "bx-ai.defaultModel", "" ),
				namedModel: variables.config.get( "bx-ai.defaultNamedModel", "" )
			} ) )
			while ( true ) {
				print( "\nYou › " )
				var input    = CLIRead()
				var response = interactive.execute( input )
				if ( response.exit ?: false ) { println( "Goodbye." ); break }
				if ( response.action == "response" ) {
					println( renderer.renderAssistant( response.content ?: "" ) )
				} else if ( response.action != "empty" ) {
					println( renderer.renderCommand( response ) )
				}
			}
		}

		return { success: true, interactive: true, sessionId: started.sessionId }
	}

}
