/**
 * NanoBox Worker Scheduler
 *
 * BoxLang scheduler entry point.  Run with:
 * {@code boxlang schedule worker/nanobox-worker.bx}
 *
 * Reads all enabled cron tasks from SQLite and registers them with the
 * BoxLang native scheduler.  Blocks until killed.  Restart the worker
 * process to pick up task changes:  {@code nanobox worker restart}
 *
 * The BoxLang runtime injects {@code scheduler} (BaseScheduler) and
 * {@code logger} properties before calling configure().
 *
 * @author Ortus Solutions
 * @version 0.1.0
 * @since 0.1.0
 */
class {

	property name="scheduler";
	property name="logger";

	/**
	 * Registers all enabled cron tasks with the BoxLang scheduler.
	 *
	 * Called automatically by the BoxLang schedule runner at startup.
	 * Also registers a 5-minute heartbeat task for liveness monitoring.
	 * Restart the worker process to reload task changes from the database.
	 */
	function configure() {
		var config = new "models.system.ConfigManager"()
		var cron   = new "models.scheduling.CronManager"()

		scheduler.setSchedulerName( "nanobox-worker" )
		scheduler.setTimezone( config.get( "worker.timezone", "UTC" ) )

		var tasks    = cron.list()
		var registered = 0

		for ( var task in tasks ) {
			if ( !( task.enabled ?: false ) ) { continue }
			if ( !len( task.schedule ?: "" ) || !len( task.prompt ?: "" ) ) { continue }
			registerTask( task, config, cron )
			registered++
		}

		logger.info( "NanoBox Worker: registered #registered# cron task(s)" )

		// Heartbeat — confirms the worker is alive every 5 minutes
		scheduler.task( "nanobox-heartbeat" )
			.call( () => logger.info( "NanoBox Worker heartbeat" ) )
			.everyMinutes( 5 )
	}

	/**
	 * Lifecycle hook called when the scheduler finishes startup.
	 * Logs the worker PID for operator reference.
	 */
	void function onStartup() {
		var pid = createObject( "java", "java.lang.ProcessHandle" ).current().pid()
		logger.info( "NanoBox Worker started (PID #pid#)" )
	}

	/**
	 * Lifecycle hook called just before the scheduler shuts down.
	 */
	void function onShutdown() {
		logger.info( "NanoBox Worker shut down" )
	}

	// -------------------------------------------------------------------------
	// Private helpers
	// -------------------------------------------------------------------------

	/**
	 * Registers a single cron task with the BoxLang scheduler.
	 *
	 * The task closure captures taskName, taskPrompt, taskCron, taskConfig, and
	 * taskDb by value so each firing uses the correct context even if the outer
	 * loop variables have changed.
	 *
	 * @task   Struct containing name, prompt, and schedule fields from CronManager
	 * @config ConfigManager instance for reading provider/model settings
	 * @cron   CronManager instance for recording run/failure outcomes
	 */
	private void function registerTask(
		required struct task,
		required any    config,
		required any    cron
	) {
		var taskName   = arguments.task.name
		var taskPrompt = arguments.task.prompt
		var taskCron   = arguments.task.schedule
		var taskConfig = arguments.config
		var taskDb     = arguments.cron

		scheduler.task( "cron-#taskName#" )
			.call( () => executeTask( taskName, taskPrompt, taskConfig, taskDb ) )
			.cron( taskCron )
	}

	/**
	 * Executes a cron task by sending its prompt to the configured AI provider.
	 *
	 * Records success via cron.run() or failure via cron.fail() so the database
	 * reflects the actual outcome.
	 *
	 * @name   Cron task name used for result recording and log messages
	 * @prompt AI prompt to send via aiChat()
	 * @config ConfigManager instance for provider/model lookup
	 * @cron   CronManager instance for recording run/failure outcomes
	 */
	private void function executeTask(
		required string name,
		required string prompt,
		required any    config,
		required any    cron
	) {
		try {
			var provider = arguments.config.get( "bx-ai.defaultProvider", "" )
			var model    = arguments.config.get( "bx-ai.defaultModel", "" )
			var params   = len( model ) ? { model: model } : {}
			aiChat( arguments.prompt, provider: provider, params: params )
			arguments.cron.run( arguments.name )
			logger.info( "Cron task '#arguments.name#' completed" )
		} catch ( any e ) {
			arguments.cron.fail( arguments.name )
			logger.error( "Cron task '#arguments.name#' failed: #e.message#" )
		}
	}

}
