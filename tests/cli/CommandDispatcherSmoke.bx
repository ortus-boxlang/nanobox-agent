import nanobox_cli.PrettyCli
import nanobox_cli.util.ConfigManager
import nanobox_cli.CommandDispatcher

class {
	function main( array args = [] ) {
		var cli = new "cli.PrettyCli"( false )
		var config = new "cli.util.ConfigManager"( getTempDirectory() & "/nanobox-dispatch-test-#createUUID()#" )
		var dispatcher = new "cli.CommandDispatcher"( cli, config, true )
		var result = dispatcher.dispatch( { positionals: [ "model" ], options: {} } )
		if ( result != "ModelCommand" ) { throw( "model should dispatch to ModelCommand" ) }
		if ( !dispatcher.isDebug() ) { throw( "debug should be propagated" ) }
		var unknown = dispatcher.dispatch( { positionals: [ "nope" ], options: {} } )
		if ( unknown != "unknown" ) { throw( "unknown commands should be rejected" ) }
		println( "CommandDispatcher smoke tests passed" )
	}
}
