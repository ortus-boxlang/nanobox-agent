class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "Interactive chat completion", () => {
			it( "auto-names sessions with slugify and preserves manual titles", () => {
				var home = getTempDirectory() & "/chat-title-#createUUID()#"
				var config = new "nanobox-cli.util.ConfigManager"( home )
				var sessions = new "nanobox-cli.SessionManager"()
				var chat = new "nanobox-cli.InteractiveChat"( new "nanobox-cli.commands.ChatCommand"( config, new "nanobox-cli.TokenTracker"( home & "/tokens.json" ) ), sessions, config )
				chat.start( false )
				var title = chat.execute( "/title Manual Project" )
				expect( title.title ).toBe( "Manual Project" )
				expect( chat.execute( "/usage" ).usage.requests ).toBe( 0 )
				expect( chat.execute( "/help" ).commands ).notToBeEmpty()
			} )
			it( "renders a Pi-style header and assistant message", () => {
				var config = new "nanobox-cli.util.ConfigManager"( getTempDirectory() & "/chat-render-#createUUID()#" )
				var chat = new "nanobox-cli.InteractiveChat"( {}, new "nanobox-cli.SessionManager"(), config )
				var renderer = new "nanobox-cli.InteractiveChatRenderer"( chat, false )
				expect( renderer.renderHeader( { title: "Demo", provider: "lmstudio", model: "local" } ) ).toInclude( "Demo" )
				expect( renderer.renderAssistant( "Hello" ) ).toInclude( "NanoBox" )
			} )
		} )
	}
}
