class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "Interactive chat surfaces", () => {
			it( "executes slash commands and persists a new session", () => {
				var home = getTempDirectory() & "/interactive-chat-#createUUID()#"
				var config = new "nanobox-cli.util.ConfigManager"( home )
				var sessions = new "nanobox-cli.SessionManager"()
				var chat = new "nanobox-cli.InteractiveChat"( new "nanobox-cli.commands.ChatCommand"( config, new "nanobox-cli.TokenTracker"( home & "/tokens.json" ) ), sessions, config )
				var started = chat.start( false )
				expect( started.success ).toBeTrue()
				expect( chat.execute( "/help" ).action ).toBe( "help" )
				expect( chat.execute( "/title Demo" ).title ).toBe( "Demo" )
				expect( chat.execute( "/status" ).sessionId ).toBe( started.sessionId )
				expect( chat.execute( "/new" ).success ).toBeTrue()
			} )
			it( "returns setup-required instead of prompting for noninteractive empty chat", () => {
				var home = getTempDirectory() & "/interactive-empty-#createUUID()#"
				var config = new "nanobox-cli.util.ConfigManager"( home )
				var result = new "nanobox-cli.CommandRuntime"( new "nanobox-cli.PrettyCli"( false ), config ).execute( { positionals: [ "chat" ], options: { z: true } } )
				expect( result.success ).toBeFalse()
				expect( result.error ).toInclude( "query" )
			} )
		} )
	}
}
