class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "Skills registry operations", () => {
			it( "queries the live skills.boxlang.io catalog", () => {
				var manager = new "nanobox-cli.SkillManager"( getTempDirectory() & "/remote-skills-#createUUID()#/skills" )
		var results = manager.findRemote( "async" )
				expect( results ).notToBeEmpty()
				expect( results.first() ).toHaveKey( "name" )
			} )
			it( "returns a structured error for malformed install slugs", () => {
				var result = new "nanobox-cli.SkillManager"( getTempDirectory() & "/bad-install-#createUUID()#/skills" ).install( "invalid" )
				expect( result.success ).toBeFalse()
			} )
		} )
	}
}
