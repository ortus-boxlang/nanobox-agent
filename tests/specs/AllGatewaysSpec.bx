class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "Unimplemented gateway contracts", () => {
			it( "implement bx-ai's IGateway but declare no capabilities", () => {
				var classes = [ "EmailGateway", "DiscordGateway", "SlackGateway", "WhatsAppGateway", "WhatsAppBusinessGateway", "SignalGateway", "SMSGateway" ]
				for ( var className in classes ) {
					var gateway = new "models.gateway.#className#"()
					expect( isInstanceOf( gateway, "IGateway" ) ).toBeTrue()
					expect( gateway.getName() ).notToBeEmpty()
					expect( gateway.getCapabilities() ).toBeEmpty()
					expect( gateway.supports( "outboundMessages" ) ).toBeFalse()
				}
			} )

			it( "fail loudly on delivery rather than reporting a false success", () => {
				var manager = new "models.gateway.GatewayManager"()
				manager.create( "slack", {}, false )
				var result = manager.send( "slack", "C123", "hello" )
				expect( result.success ).toBeFalse()
				expect( result.error ).toInclude( "does not support outbound" )
			} )
		} )
	}
}
