class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "TokenCommand", () => {
			it( "returns totals and provider breakdown", () => {
				var tracker = new "nanobox-cli.TokenTracker"( getTempDirectory() & "/tokens-#createUUID()#.json" )
				tracker.record( { prompt_tokens: 10, completion_tokens: 5 }, "lmstudio", "model-a" )
				var command = new "nanobox-cli.commands.TokenCommand"( tracker )
				var result = command.execute( "all", "provider" )
				expect( result.success ).toBeTrue()
				expect( result.totals.totalTokens ).toBe( 15 )
				expect( result.breakdown ).toHaveLength( 1 )
			} )
		} )
	}
}
