class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "ToolManager", () => {
			it( "lists all tools from the registry with enabled/disabled state", () => {
				var config = new "models.system.ConfigManager"()
				var manager = new "models.tools.ToolManager"( config.getNanoboxHome(), config )
				var index = manager.list()
				expect( index ).notToBeEmpty()
				for ( var key in index ) {
					expect( index[ key ] ).toHaveKey( "name" )
					expect( index[ key ] ).toHaveKey( "description" )
					expect( index[ key ] ).toHaveKey( "module" )
					expect( index[ key ] ).toHaveKey( "enabled" )
				}
			} )

			it( "shows a specific tool by key", () => {
				var config = new "models.system.ConfigManager"()
				var manager = new "models.tools.ToolManager"( config.getNanoboxHome(), config )
				var index = manager.list()
				var keys = index.keyArray()
				if ( keys.len() ) {
					var tool = manager.show( keys[ 1 ] )
					expect( tool ).notToBeEmpty()
					expect( tool ).toHaveKey( "name" )
					expect( tool ).toHaveKey( "description" )
				}
			} )

			it( "returns empty struct for nonexistent tool key", () => {
				var config = new "models.system.ConfigManager"()
				var manager = new "models.tools.ToolManager"( config.getNanoboxHome(), config )
				var tool = manager.show( "nonexistent_tool_xyz" )
				expect( tool ).toBeEmpty()
			} )

			it( "enables and disables a tool", () => {
				var config = new "models.system.ConfigManager"()
				var manager = new "models.tools.ToolManager"( config.getNanoboxHome(), config )
				var index = manager.list()
				var keys = index.keyArray()
				if ( keys.len() ) {
					var key = keys[ 1 ]
					var result = manager.enable( key )
					expect( result.success ).toBeTrue()
					expect( result.enabled ).toBeTrue()

					result = manager.disable( key )
					expect( result.success ).toBeTrue()
					expect( result.enabled ).toBeFalse()
				}
			} )

			it( "enable returns error for nonexistent key", () => {
				var config = new "models.system.ConfigManager"()
				var manager = new "models.tools.ToolManager"( config.getNanoboxHome(), config )
				var result = manager.enable( "nonexistent_tool_xyz" )
				expect( result.success ).toBeFalse()
			} )

			it( "status returns total, enabled, and disabled counts", () => {
				var config = new "models.system.ConfigManager"()
				var manager = new "models.tools.ToolManager"( config.getNanoboxHome(), config )
				var status = manager.status()
				expect( status ).toHaveKey( "total" )
				expect( status ).toHaveKey( "enabled" )
				expect( status ).toHaveKey( "disabled" )
				expect( status.total ).toBeGTE( 0 )
				expect( status.total ).toBe( status.enabled + status.disabled )
			} )

			it( "refresh re-scans sources and rebuilds the index", () => {
				var config = new "models.system.ConfigManager"()
				var manager = new "models.tools.ToolManager"( config.getNanoboxHome(), config )
				var index = manager.refresh()
				expect( index ).notToBeEmpty()
			} )
		} )

		describe( "ToolCommand", () => {
			it( "list returns tools array with total", () => {
				var config = new "models.system.ConfigManager"()
				var cmd = new "cli.commands.ToolCommand"( new "models.tools.ToolManager"( config.getNanoboxHome(), config ) )
				var result = cmd.execute( "list" )
				expect( result.success ).toBeTrue()
				expect( result ).toHaveKey( "tools" )
				expect( result ).toHaveKey( "total" )
				expect( result.total ).toBeGTE( 0 )
			} )

			it( "show returns tool details for valid key", () => {
				var config = new "models.system.ConfigManager"()
				var cmd = new "cli.commands.ToolCommand"( new "models.tools.ToolManager"( config.getNanoboxHome(), config ) )
				var listResult = cmd.execute( "list" )
				if ( listResult.total > 0 ) {
					var key = listResult.tools[ 1 ].key
					var result = cmd.execute( "show", { key: key } )
					expect( result.success ).toBeTrue()
					expect( result.tool ).toHaveKey( "name" )
				}
			} )

			it( "show returns error for invalid key", () => {
				var config = new "models.system.ConfigManager"()
				var cmd = new "cli.commands.ToolCommand"( new "models.tools.ToolManager"( config.getNanoboxHome(), config ) )
				var result = cmd.execute( "show", { key: "does_not_exist" } )
				expect( result.success ).toBeFalse()
			} )

			it( "enable and disable toggle tool state", () => {
				var config = new "models.system.ConfigManager"()
				var cmd = new "cli.commands.ToolCommand"( new "models.tools.ToolManager"( config.getNanoboxHome(), config ) )
				var list = cmd.execute( "list" )
				if ( list.total > 0 ) {
					var key = list.tools[ 1 ].key
					var enableResult = cmd.execute( "enable", { key: key } )
					expect( enableResult.success ).toBeTrue()
					expect( enableResult.enabled ).toBeTrue()

					var disableResult = cmd.execute( "disable", { key: key } )
					expect( disableResult.success ).toBeTrue()
					expect( disableResult.enabled ).toBeFalse()
				}
			} )

			it( "enable returns error for nonexistent key", () => {
				var config = new "models.system.ConfigManager"()
				var cmd = new "cli.commands.ToolCommand"( new "models.tools.ToolManager"( config.getNanoboxHome(), config ) )
				var result = cmd.execute( "enable", { key: "does_not_exist" } )
				expect( result.success ).toBeFalse()
			} )

			it( "status returns total/enabled/disabled", () => {
				var config = new "models.system.ConfigManager"()
				var cmd = new "cli.commands.ToolCommand"( new "models.tools.ToolManager"( config.getNanoboxHome(), config ) )
				var result = cmd.execute( "status" )
				expect( result.total ).toBeGTE( 0 )
				expect( result.enabled + result.disabled ).toBe( result.total )
			} )

			it( "refresh rebuilds the index", () => {
				var config = new "models.system.ConfigManager"()
				var cmd = new "cli.commands.ToolCommand"( new "models.tools.ToolManager"( config.getNanoboxHome(), config ) )
				var result = cmd.execute( "refresh" )
				expect( result.success ).toBeTrue()
			} )

			it( "unknown action returns error", () => {
				var config = new "models.system.ConfigManager"()
				var cmd = new "cli.commands.ToolCommand"( new "models.tools.ToolManager"( config.getNanoboxHome(), config ) )
				var result = cmd.execute( "blargh" )
				expect( result.success ).toBeFalse()
			} )
		} )
	}
}