class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "Active skills and vault CLI", () => {
			it( "routes skill and vault commands through runtime", () => {
				var home = getTempDirectory() & "/active-skills-vault-#createUUID()#"
				var config = new "cli.util.ConfigManager"( home )
				var runtime = new "cli.CommandRuntime"( new "cli.PrettyCli"( false ), config )
				expect( runtime.execute( { positionals: [ "skill", "create", "runtime-skill" ], options: { content: "Runtime skill" } } ).success ).toBeTrue()
				expect( runtime.execute( { positionals: [ "skill", "show", "runtime-skill" ], options: {} } ).success ).toBeTrue()
				expect( runtime.execute( { positionals: [ "skill", "remove", "runtime-skill" ], options: {} } ).success ).toBeTrue()
			} )
		} )
	}
}
