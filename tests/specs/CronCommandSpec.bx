class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "CronCommand", () => {
			it( "creates, pauses, resumes, runs, lists, and deletes tasks", () => {
				var path = getTempDirectory() & "/cron-#createUUID()#.json"
				var manager = new "cli.CronManager"( path )
				var command = new "cli.commands.CronCommand"( manager )
				expect( command.execute( "create", { name: "daily", schedule: "0 9 * * *", prompt: "Run report" } ).success ).toBeTrue()
				expect( command.execute( "list" ).tasks ).toHaveLength( 1 )
				expect( command.execute( "pause", { name: "daily" } ).task.enabled ).toBeFalse()
				expect( command.execute( "resume", { name: "daily" } ).task.enabled ).toBeTrue()
				expect( command.execute( "run", { name: "daily" } ).success ).toBeTrue()
				expect( command.execute( "delete", { name: "daily" } ).success ).toBeTrue()
			} )
		} )
	}
}
