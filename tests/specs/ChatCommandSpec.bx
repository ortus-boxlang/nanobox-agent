class extends="testbox.system.BaseSpec" {
	function run() {
		var live = new "tests.support.LiveProviders"()
		describe( "ChatCommand", () => {
			it( "reports missing provider without calling AI", () => {
				var home = getTempDirectory() & "/chat-command-#createUUID()#"
				var config = new "models.system.ConfigManager"( home )
				var tracker = new "models.util.TokenTracker"( home & "/tokens.json" )
				var command = new "cli.commands.ChatCommand"( config, tracker )
				var result = command.execute( "hello" )
				expect( result.success ).toBeFalse()
				expect( result.error ).toInclude( "No AI provider" )
			} )
			// Live spec: drives a real OpenAI-compatible provider. Needs NOVITA_API_KEY.
			it( title = "normalizes an OpenAI-compatible provider and preserves its base URL", skip = live.skipUnlessAvailable(), body = () => {
				var home = getTempDirectory() & "/chat-command-compatible-#createUUID()#"
				var config = new "models.system.ConfigManager"( home )
				config.set( "bx-ai.defaultProvider", live.providerName() )
				config.set( "bx-ai.defaultModel", live.model() )
				config.set( "bx-ai.providers.#live.providerName()#", live.providerConfig() )
				var tracker = new "models.util.TokenTracker"( home & "/tokens.json" )
				var command = new "cli.commands.ChatCommand"( config, tracker )
				var result = command.execute( "hello", { model: live.model() } )
				expect( result.success ).toBeTrue()
				expect( result.serviceProvider ).toBe( "openai-compatible" )
				expect( result.content ).notToBeEmpty()
			} )
		} )
	}
}
