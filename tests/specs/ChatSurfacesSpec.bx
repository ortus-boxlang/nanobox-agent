class extends="testbox.system.BaseSpec" {
	function run() {
		var live = new "tests.support.LiveProviders"()
		describe( "Chat surfaces", () => {
			// Live spec: drives a real OpenAI-compatible provider. Needs NOVITA_API_KEY.
			it( title = "supports response-only execution through the active runtime", skip = live.skipUnlessAvailable(), body = () => {
				var home = getTempDirectory() & "/chat-z-#createUUID()#"
				var config = new "models.system.ConfigManager"( home )
				config.set( "bx-ai.defaultProvider", live.providerName() )
				config.set( "bx-ai.defaultModel", live.model() )
				config.set( "bx-ai.providers.#live.providerName()#", live.providerConfig() )
				var runtime = new "cli.CommandRuntime"( new "cli.util.PrettyCli"( false ), config )
				var result = runtime.execute( { positionals: [ "chat", "Reply with exactly Z_RUNTIME_OK" ], options: { z: true } } )
				expect( result.success ).toBeTrue()
				expect( result.text ).toInclude( "Z_RUNTIME_OK" )
			} )
			it( "supports interactive slash commands without a provider call", () => {
				var home = getTempDirectory() & "/chat-slash-#createUUID()#"
				var config = new "models.system.ConfigManager"( home )
				var chat = new "cli.util.InteractiveChat"( new "cli.commands.ChatCommand"( config, new "models.util.TokenTracker"( home & "/tokens.json" ) ), new "models.sessions.SessionManager"(), config )
				chat.start( false )
				expect( chat.execute( "/help" ).success ).toBeTrue()
				expect( chat.execute( "/model" ).success ).toBeTrue()
				expect( chat.execute( "/exit" ).exit ).toBeTrue()
			} )
		} )
	}
}
