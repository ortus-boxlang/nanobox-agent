class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "CommandDispatcher gateway wiring", () => {
			it( "parses gateway actions and options", () => {
				var dispatcher = new "nanobox-cli.CommandDispatcher"( new "nanobox-cli.PrettyCli"( false ), new "nanobox-cli.util.ConfigManager"( getTempDirectory() & "/dispatch-#createUUID()#" ) )
				var result = dispatcher.dispatch( { positionals: [ "gateway", "send", "telegram", "42", "hello" ], options: {} } )
				expect( result.handler ).toBe( "GatewayCommand" )
				expect( result.action ).toBe( "send" )
				expect( result.args.name ).toBe( "telegram" )
				expect( result.args.recipient ).toBe( "42" )
				expect( result.args.message ).toBe( "hello" )
			} )
		} )
	}
}
