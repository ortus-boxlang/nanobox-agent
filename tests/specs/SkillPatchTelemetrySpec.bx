class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "Skill patch telemetry", () => {
			it( "records registry installation as a patch/update event", () => {
				var root = getTempDirectory() & "/patch-telemetry-#createUUID()#"
				var manager = new "models.skills.SkillManager"( root & "/.agents/skills" )
				var result = manager.install( "invalid" )
				expect( result.success ).toBeFalse()
			} )
			it( "records an explicit patch event", () => {
				var root = getTempDirectory() & "/patch-explicit-#createUUID()#"
				var manager = new "models.skills.SkillManager"( root & "/.agents/skills" )
				manager.create( "patched-skill", "Patched", "Content" )
				manager.recordPatch( "patched-skill" )
				var usage = jsonDeserialize( fileRead( root & "/.agents/skills-custom/patched-skill/.usage.json" ) )
				expect( usage.patchCount ).toBe( 1 )
				expect( usage.activityCount ).toBe( 2 )
			} )
		} )
	}
}
