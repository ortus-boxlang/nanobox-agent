class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "WebCommand", () => {
			it( "starts and stops the MiniServer process", () => {
				var state = getTempDirectory() & "/web-processes-#createUUID()#.json"
				var manager = new "models.system.ProcessManager"( state )
				var command = new "cli.commands.WebCommand"( manager, getTempDirectory() )
				var started = command.execute( "start", { port: 18991 } )
				if ( !started.success && findNoCase( "not found", started.error ?: "" ) ) { return }
				expect( started.success ).toBeTrue()
				expect( command.execute( "status" ).status ).toBe( "running" )
				expect( command.execute( "stop" ).success ).toBeTrue()
			} )
		} )
	}
}
