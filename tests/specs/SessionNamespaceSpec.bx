class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "Complete session namespace", () => {
			it( "supports create, show, rename, search, export, stats, and delete", () => {
				var schema = new "models.sessions.SessionSchema"(); schema.main()
				var manager = new "models.sessions.SessionManager"()
				var command = new "cli.commands.SessionCommand"( manager )
				var created = command.execute( "create", { title: "Session lifecycle", provider: "lmstudio", model: "local" } )
				var id = created.session.id
				manager.appendMessage( id, { role: "user", content: "searchable question" } )
				manager.appendMessage( id, { role: "assistant", content: "searchable answer" } )
				expect( command.execute( "show", { id: id } ).session.messages ).toHaveLength( 2 )
				expect( command.execute( "rename", { id: id, title: "Renamed session" } ).session.title ).toBe( "Renamed session" )
				expect( command.execute( "search", { query: "searchable" } ).sessions ).notToBeEmpty()
				expect( command.execute( "export", { id: id } ).content ).toInclude( "searchable question" )
				expect( command.execute( "stats", {} ).stats.messages ).toBeGTE( 2 )
				expect( command.execute( "delete", { id: id } ).success ).toBeTrue()
				expect( command.execute( "show", { id: id } ).success ).toBeFalse()
			} )
			it( "supports dry-run prune and validates failures", () => {
				var command = new "cli.commands.SessionCommand"( new "models.sessions.SessionManager"() )
				expect( command.execute( "prune", { olderThanDays: 0, dryRun: true } ).result.dryRun ).toBeTrue()
				expect( command.execute( "show", {} ).success ).toBeFalse()
				expect( command.execute( "search", {} ).success ).toBeFalse()
				expect( command.execute( "unknown", {} ).success ).toBeFalse()
			} )
		} )
	}
}
