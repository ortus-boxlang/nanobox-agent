class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "Curator lifecycle protection", () => {
			it( "protects cron and agent referenced skills", () => {
				var root = getTempDirectory() & "/lifecycle-#createUUID()#"
				var manager = new "cli.SkillManager"( root & "/.agents/skills" )
				manager.create( "protected-skill", "Protected", "Content" )
				var cron = new "cli.CronManager"( root & "/cron.json" )
				cron.create( "job", "daily", "prompt", "default", [ "protected-skill" ] )
				var config = new "cli.util.ConfigManager"( root & "/config" )
				var reports = new "cli.CuratorReportManager"( root )
				var lifecycle = new "cli.CuratorLifecycle"( config, new "cli.SkillCurator"( root ), reports, cron )
				var result = lifecycle.tick( true, true )
				expect( result.protectedSkills ).toInclude( "protected-skill" )
			} )
		} )
	}
}
