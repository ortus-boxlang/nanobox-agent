class extends="testbox.system.BaseSpec" {
	function run() {
		describe( "Active agent CLI", () => {
			it( "routes agent lifecycle through CommandRuntime", () => {
				var home = getTempDirectory() & "/active-agents-#createUUID()#"
				var config = new "models.system.ConfigManager"( home )
				var runtime = new "cli.CommandRuntime"( new "models.util.PrettyCli"( false ), config )
				expect( runtime.execute( { positionals: [ "agent", "create", "runtime-agent" ], options: { description: "Runtime", instructions: "Be concise.", model: "local" } } ).success ).toBeTrue()
				expect( runtime.execute( { positionals: [ "agent", "show", "runtime-agent" ], options: {} } ).success ).toBeTrue()
				expect( runtime.execute( { positionals: [ "agent", "list" ], options: {} } ).agents ).toHaveLength( 1 )
				expect( runtime.execute( { positionals: [ "agent", "delete", "runtime-agent" ], options: {} } ).success ).toBeTrue()
			} )
		} )
	}
}
