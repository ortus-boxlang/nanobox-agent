class {
	variables.thisDir = getDirectoryFromPath( getCurrentTemplatePath() )
	this.mappings = {
		"/testbox": variables.thisDir & "../lib/testbox",
		"/tests"  : variables.thisDir,
		"/cli"    : variables.thisDir & "../cli",
		"/models" : variables.thisDir & "../models",
		"/nanobox": variables.thisDir & "../"
	}
}
