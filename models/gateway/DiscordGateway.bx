/**
 * DiscordGateway — Discord messaging platform implementation of IGateway.
 *
 * Stub implementation that inherits lifecycle management from BaseGateway.
 * Full Discord Bot API integration (slash commands, webhooks, message events)
 * is planned for a future release.
 *
 * @author Ortus Solutions
 * @version 0.1.0
 * @since 0.1.0
 */
class extends="models.gateway.BaseGateway" {

	/**
	 * @config  Config struct; expected keys: botToken, guildId
	 */
	function init( struct config = {} ) { super.init( "discord", arguments.config ); return this }

	/**
	 * Returns the feature capabilities supported by the Discord platform.
	 *
	 * @return Capabilities struct with full media, reaction, thread, and HITL support
	 */
	struct function capabilities() { return { text: true, attachments: true, images: true, audio: true, video: true, reactions: true, threads: true, buttons: true, hitl: true, hitlModes: [ "web" ], hitlMode: "web", hitlDecision: "suspend-resume" } }
}
