/**
 * WhatsAppBusinessGateway — WhatsApp Business API implementation of IGateway.
 *
 * Stub implementation for the enterprise WhatsApp Business API tier, which supports
 * message templates and official business accounts.  Inherits lifecycle management
 * from BaseGateway.  Full integration is planned for a future release.
 *
 * @author Ortus Solutions
 * @version 0.1.0
 * @since 0.1.0
 */
class extends="models.gateway.BaseGateway" {

	/**
	 * @config  Config struct; expected keys: businessAccountId, accessToken, phoneNumberId, webhookVerifyToken
	 */
	function init( struct config = {} ) { super.init( "whatsapp-business", arguments.config ); return this }

	/**
	 * Returns the feature capabilities supported by the WhatsApp Business platform.
	 *
	 * @return Capabilities struct with full media and reaction support (no threads)
	 */
	struct function capabilities() { return { text: true, attachments: true, images: true, audio: true, video: true, reactions: true, threads: false, buttons: true, hitl: true, hitlModes: [ "web" ], hitlMode: "web", hitlDecision: "suspend-resume" } }
}
