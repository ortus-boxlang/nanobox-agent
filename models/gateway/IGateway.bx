/**
 * IGateway — contract for all NanoBox messaging gateway adapters.
 *
 * Every gateway implementation must honour this interface so it can be
 * registered with GatewayRegistry and routed by GatewayCommand.
 *
 * @author Ortus Solutions
 * @version 0.1.0
 * @since 0.1.0
 */
interface {
	/**
	 * Establishes a connection to the messaging platform.
	 *
	 * @return Status struct with at least connected and lastError keys
	 */
	struct function connect()

	/**
	 * Disconnects from the messaging platform.
	 *
	 * @return Status struct
	 */
	struct function disconnect()

	/**
	 * Returns the current connection status of this gateway.
	 *
	 * @return Struct with name, connected, connectedSince, messagesToday, and lastError keys
	 */
	struct function status()

	/**
	 * Sends a message to a recipient.
	 *
	 * @recipient  Platform-specific recipient identifier
	 * @message    Text body to send
	 * @return     Struct with success flag and delivery details
	 */
	struct function send( required string recipient, required string message )

	/**
	 * Processes an inbound message payload.
	 *
	 * @payload  Raw inbound data from the platform
	 * @return   Struct with success flag and normalised data
	 */
	struct function receive( required struct payload )

	/**
	 * Returns the feature capabilities of this gateway.
	 *
	 * @return Struct with text, attachments, images, hitl, and other feature flags
	 */
	struct function capabilities()

	/**
	 * Returns the platform name for this gateway.
	 *
	 * @return Platform name string (e.g. "telegram")
	 */
	string function getName()
}
