/**
 * BaseGateway — default implementation of IGateway for messaging platform adapters.
 *
 * Concrete gateway classes (TelegramGateway, DiscordGateway, etc.) extend this
 * class and override connect(), send(), and capabilities() to add
 * platform-specific behaviour.
 *
 * @author Ortus Solutions
 * @version 0.1.0
 * @since 0.1.0
 */
class implements="IGateway" {
	property name;
	property config;
	property connected;
	property connectedSince;
	property messagesToday;
	property lastError;

	/**
	 * @name    Platform identifier (e.g. "telegram", "discord")
	 * @config  Platform-specific configuration struct (tokens, URLs, etc.)
	 */
	function init( required string name, struct config = {} ) {
		variables.name = arguments.name
		variables.config = arguments.config
		variables.connected = false
		variables.connectedSince = ""
		variables.messagesToday = 0
		variables.lastError = ""
		return this
	}

	/**
	 * Establishes a connection to the messaging platform.
	 *
	 * Default implementation marks the gateway as connected and records the time.
	 * Subclasses should override to perform real authentication.
	 *
	 * @return Status struct from status()
	 */
	struct function connect() { variables.connected = true; variables.connectedSince = now(); variables.lastError = ""; return status() }

	/**
	 * Disconnects from the messaging platform.
	 *
	 * @return Status struct from status()
	 */
	struct function disconnect() { variables.connected = false; return status() }

	/**
	 * Returns the current connection status of this gateway.
	 *
	 * @return Struct with name, connected, connectedSince, messagesToday, and lastError keys
	 */
	struct function status() { return { name: variables.name, connected: variables.connected, connectedSince: variables.connectedSince, messagesToday: variables.messagesToday, lastError: variables.lastError } }

	/**
	 * Sends a message to a recipient via the platform.
	 *
	 * Default implementation returns success without actually sending.
	 * Subclasses must override for real delivery.
	 *
	 * @recipient  Platform-specific recipient identifier (chat ID, email, phone, etc.)
	 * @message    Text body to send
	 * @return     Struct with success flag and delivery details
	 */
	struct function send( required string recipient, required string message ) { if ( !variables.connected ) { return { success: false, error: "Gateway is not connected" } }; return { success: true, recipient: arguments.recipient, message: arguments.message } }

	/**
	 * Processes an inbound message payload and increments the daily counter.
	 *
	 * @payload  Raw inbound payload from the platform webhook or poll
	 * @return   Struct with success, gateway name, and raw payload
	 */
	struct function receive( required struct payload ) { variables.messagesToday++; return { success: true, gateway: variables.name, payload: arguments.payload } }

	/**
	 * Returns the capabilities supported by this gateway.
	 *
	 * Subclasses should override to advertise their platform-specific features.
	 *
	 * @return Struct with text, attachments, images, audio, video, reactions, threads,
	 *         buttons, hitl, hitlModes, hitlMode, and hitlDecision keys
	 */
	struct function capabilities() { return { text: true, attachments: false, images: false, audio: false, video: false, reactions: false, threads: false, buttons: false, hitl: false, hitlModes: [], hitlMode: "unsupported", hitlDecision: "none" } }

	/**
	 * Returns the platform name for this gateway.
	 *
	 * @return Platform name string
	 */
	string function getName() { return variables.name }
}
