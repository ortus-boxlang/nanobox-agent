/**
 * TelegramGateway — Telegram Bot API adapter built on bx-ai's IGateway contract.
 *
 * Authenticates via the bot token in options.botToken, delivers outbound messages
 * through sendMessage, and normalizes inbound updates (long-polled via getUpdates,
 * or handed in from a webhook) into bx-ai GatewayMessage instances.
 *
 * @author Ortus Solutions
 * @version 0.2.0
 * @since 0.1.0
 */
import bxModules.bxai.models.gateway.IGateway;
import bxModules.bxai.models.gateway.contracts.GatewayContext;
import bxModules.bxai.models.gateway.contracts.GatewayDeliveryResult;
import bxModules.bxai.models.gateway.contracts.GatewayEvent;
import bxModules.bxai.models.gateway.contracts.GatewayMessage;

class extends="bxModules.bxai.models.gateway.BaseGateway" {

	property apiBase;
	property updateOffset;

	function init() {
		variables.name = "telegram"
		variables.description = "Telegram Bot API gateway"
		variables.options = {}
		variables.apiBase = "https://api.telegram.org"
		variables.updateOffset = 0
		return this
	}

	/**
	 * @options  Expected keys: botToken (required), apiBase (optional), timeout (default 15s)
	 */
	IGateway function configure( required any options ) {
		super.configure( arguments.options )
		variables.apiBase = variables.options.apiBase ?: "https://api.telegram.org"
		return this
	}

	public array function getDeclaredCapabilities() {
		return [ "inboundMessages", "outboundMessages", "threads" ]
	}

	/**
	 * Authenticates against the Bot API. Throws so start() leaves the gateway
	 * not-running when credentials are missing or rejected.
	 */
	public void function onStart() {
		if ( !len( variables.options.botToken ?: "" ) ) {
			throw( type: "NanoBox.GatewayConfigError", message: "Telegram bot token is not configured" )
		}

		var response = callApi( "getMe", {} )
		if ( !( response.ok ?: false ) ) {
			throw(
				type   : "NanoBox.GatewayConnectError",
				message: response.description ?: "Telegram authentication failed"
			)
		}
	}

	/**
	 * Delivers a message to a Telegram chat.
	 *
	 * @event    Carries the text to send in data.text
	 * @context  Identifies the chat via threadID (falling back to conversationID)
	 */
	public GatewayDeliveryResult function deliver( required GatewayEvent event, required GatewayContext context ) {
		var chatId = len( arguments.context.getThreadID() ) ? arguments.context.getThreadID() : arguments.context.getConversationID()
		if ( !len( chatId ) ) {
			return GatewayDeliveryResult.failure( "No Telegram chat id on the gateway context" )
		}

		var text = arguments.event.getData().text ?: ""
		try {
			var response = callApi( "sendMessage", { chat_id: chatId, text: text } )
			if ( !( response.ok ?: false ) ) {
				return GatewayDeliveryResult.failure( response.description ?: "Telegram send failed" )
			}
			return new GatewayDeliveryResult(
				success   : true,
				deliveryID: toString( response.result.message_id ?: "" ),
				raw       : response
			)
		} catch ( any exception ) {
			return GatewayDeliveryResult.failure( exception.message ?: "Telegram send failed" )
		}
	}

	/**
	 * Normalizes a raw Telegram payload into GatewayMessage instances. Accepts either a
	 * single update (a webhook body) or a getUpdates response carrying a result array.
	 *
	 * @payload  Raw Telegram update, or a struct with a result array of updates
	 */
	public array function parseInbound( required any payload, struct requestContext = {} ) {
		var updates = isStruct( arguments.payload ) && arguments.payload.keyExists( "result" ) ? arguments.payload.result : [ arguments.payload ]

		return updates.map( ( update ) => {
			var message = update.message ?: update.callback_query?.message ?: {}
			var sender  = message.from ?: update.callback_query?.from ?: {}
			var context = new GatewayContext(
				gateway       : variables.name,
				conversationID: toString( message.chat?.id ?: "" ),
				threadID      : toString( message.chat?.id ?: "" ),
				userID        : toString( sender.id ?: "" ),
				identity      : { username: sender.username ?: "" },
				raw           : update
			)

			return new GatewayMessage(
				type   : update.keyExists( "callback_query" ) ? "action" : "message",
				text   : message.text ?: update.callback_query?.data ?: "",
				context: context,
				raw    : update
			)
		} )
	}

	/**
	 * Long-polls Telegram for pending updates, advancing the internal offset so each
	 * call only returns messages not yet seen.
	 *
	 * @timeout  Long-poll timeout in seconds
	 * @return   Struct with success, an array of GatewayMessage, and optional error
	 */
	struct function poll( numeric timeout = 10 ) {
		if ( !isRunning() ) {
			return { success: false, error: "Gateway is not running", messages: [] }
		}

		try {
			var response = callApi( "getUpdates", {
				offset          : variables.updateOffset,
				timeout         : arguments.timeout,
				allowed_updates : [ "message", "callback_query" ]
			} )
			if ( !( response.ok ?: false ) ) {
				return { success: false, error: response.description ?: "Telegram polling failed", messages: [] }
			}

			for ( var update in ( response.result ?: [] ) ) {
				variables.updateOffset = max( variables.updateOffset, ( update.update_id ?: 0 ) + 1 )
			}

			return { success: true, messages: parseInbound( response ) }
		} catch ( any exception ) {
			return { success: false, error: exception.message ?: "Telegram polling failed", messages: [] }
		}
	}

	/**
	 * Makes an authenticated POST request to the Telegram Bot API.
	 *
	 * @method      API method name (e.g. "sendMessage", "getUpdates")
	 * @parameters  Request body parameters
	 */
	private struct function callApi( required string method, struct parameters = {} ) {
		var response = http(
			url    : variables.apiBase & "/bot" & ( variables.options.botToken ?: "" ) & "/" & arguments.method,
			method : "POST",
			timeout: variables.options.timeout ?: 15,
			charset: "utf-8",
			body   : jsonSerialize( arguments.parameters ),
			headers: { "Content-Type": "application/json" }
		)
		return jsonDeserialize( response.fileContent ?: response.content ?: "{}" )
	}

}
