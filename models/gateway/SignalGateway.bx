/**
 * SignalGateway — not yet implemented.
 *
 * Registered so the platform is discoverable and configurable, but it declares no
 * capabilities: bx-ai's IGateway defaults make every unsupported operation fail
 * loudly (a failed GatewayDeliveryResult, or GatewayCapabilityNotSupported) rather
 * than silently reporting success.
 *
 * @author Ortus Solutions
 * @version 0.2.0
 * @since 0.1.0
 */
class extends="bxModules.bxai.models.gateway.BaseGateway" {

	function init() {
		variables.name = "signal"
		variables.description = "Signal (signal-cli) gateway (not implemented)"
		variables.options = {}
		return this
	}

	public array function getDeclaredCapabilities() {
		return []
	}

}
