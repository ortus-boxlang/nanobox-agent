/**
 * ConfigTools — AI-callable tools for reading and writing NanoBox configuration values.
 *
 * Exposes two tools to the bx-ai tool registry that allow an LLM agent to inspect
 * and modify the NanoBox configuration file at runtime.
 *
 * @author Ortus Solutions
 * @version 0.1.0
 * @since 0.1.0
 */
class {
	@AITool( "Read a NanoBox configuration value by key. Returns the current value or empty string if not set." )
	public string function config_get( required string key ) {
		return new "/cli/util/ConfigManager"().get( arguments.key, "" ).toString()
	}

	@AITool( "Set a NanoBox configuration value by key and value. Persists the change to disk immediately." )
	public struct function config_set( required string key, required string value ) {
		new "/cli/util/ConfigManager"().set( arguments.key, arguments.value )
		return { success: true, key: arguments.key, value: arguments.value }
	}
}
