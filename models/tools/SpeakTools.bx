/**
 * SpeakTools — AI-callable tools for text-to-speech via bx-ai.
 *
 * Exposes speech synthesis tools to the bx-ai tool registry, wrapping
 * the aiSpeak() BIF with voice, speed, and format options.
 *
 * @author Ortus Solutions
 * @version 0.1.0
 * @since 0.1.0
 */
class {

	@AITool( "Convert text to speech using AI. Returns the file path of the generated audio. Supports options: voice (alloy, echo, fable, nova, shimmer, coral), speed (0.25 to 4.0, default 1.0), format (mp3, opus, aac, flac, wav). Audio files are saved to ~/Audio/nanobox/." )
	public struct function speak_generate(
		required string text,
		string voice = "alloy",
		numeric speed = 1.0,
		string format = "mp3",
		string provider = "",
		string model = ""
	) {
		var params = {
			model: arguments.model,
			voice: arguments.voice,
			speed: arguments.speed,
			response_format: arguments.format
		}
		var options = { provider: arguments.provider }
		// Default output path
		var dir = expandPath( "~/Audio/nanobox" )
		if ( !directoryExists( dir ) ) { directoryCreate( dir ) }
		var ts = dateTimeFormat( now(), "yyyymmdd_HHnnss" )
		options.outputFile = dir & "/speech_#ts#.#arguments.format#"

		try {
			var result = aiSpeak( arguments.text, params, options )
			return {
				success: true,
				path: options.outputFile,
				text: arguments.text,
				voice: arguments.voice,
				format: arguments.format,
				provider: len( arguments.provider ) ? arguments.provider : "default"
			}
		} catch ( any e ) {
			return { success: false, error: e.message, text: left( arguments.text, 100 ) }
		}
	}

}
