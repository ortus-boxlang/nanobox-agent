/**
 * SkillTools — AI-callable tools for browsing installed NanoBox skills.
 *
 * Exposes tools to the bx-ai tool registry that allow an LLM agent to list all
 * installed skills and retrieve detailed information about a specific skill by name.
 *
 * @author Ortus Solutions
 * @version 0.1.0
 * @since 0.1.0
 */
class {
	@AITool( "List all installed skills with their name, description, version, and activation status." )
	public array function skill_list() {
		return new "/cli/SkillManager"( expandPath( ".agents/skills" ) ).list()
	}

	@AITool( "Show detailed information about a specific installed skill by name." )
	public struct function skill_show( required string name ) {
		var result = new "/cli/SkillManager"( expandPath( ".agents/skills" ) ).show( arguments.name )
		return structIsEmpty( result ) ? { error: "Skill not found: " & arguments.name } : result
	}
}
