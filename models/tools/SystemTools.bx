/**
 * SystemTools — AI-callable tools for executing system commands.
 *
 * Exposes a sandboxed command execution tool to the bx-ai tool registry that allows
 * an LLM agent to run scripts in external interpreters (shell, Python, Node.js, etc.).
 * A built-in blocklist rejects the most dangerous shell patterns before execution.
 *
 * @author Ortus Solutions
 * @version 0.1.0
 * @since 0.1.0
 */
class {
	@AITool( "Execute a command in any available language interpreter (Python, Node.js, Lua, shell, etc.). Returns stdout, stderr, and exit code. Use this when you need to run code or scripts that BoxLang cannot directly execute." )
	public struct function system_exec(
		required string command,
		string language = "shell",
		numeric timeout = 30,
		string workdir = ""
	) {
		// Security: validate the command against dangerous patterns
		var lower = arguments.command.lcase()
		var blocked = [ "rm -rf", "sudo ", "> /dev", "dd if=", ":(){ :|:& };:", "mkfs", "chmod 777", "wget http://", "curl http://" ]
		for ( var pattern in blocked ) {
			if ( lower.find( pattern ) ) {
				return { success: false, error: "Command blocked for security: contains dangerous pattern" }
			}
		}

		try {
			var result = systemExecute(
				arguments.command,
				arguments.timeout,
				len( arguments.workdir ) ? arguments.workdir : getCWD()
			)
			return {
				success: true,
				stdout: result.stdout ?: "",
				stderr: result.stderr ?: "",
				exitCode: result.exitCode ?: 0
			}
		} catch ( any e ) {
			return { success: false, error: e.message }
		}
	}
}
