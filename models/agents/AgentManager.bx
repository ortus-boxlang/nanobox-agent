class {
	property agentsPath;
	property config;
	function init( string agentsPath = "", any configManager = null ) { variables.agentsPath = len( arguments.agentsPath ) ? arguments.agentsPath : expandPath( "~/.nanobox/agents" ); variables.config = arguments.configManager; if ( !directoryExists( variables.agentsPath ) ) { directoryCreate( variables.agentsPath, true ) }; return this }
	array function list() { var result = []; for ( var file in directoryList( variables.agentsPath, false, "query", "*.md" ) ) { result.append( parse( file.directory & "/" & file.name ) ) }; return result }
	array function referencedSkills() { var result = []; for ( var agent in list() ) { for ( var name in agent.metadata.skills ?: [] ) { if ( !result.contains( name ) ) { result.append( name ) } } }; return result }
	struct function show( required string name ) { var path = agentPath( arguments.name ); return fileExists( path ) ? parse( path ) : {} }
	struct function create( required string name, string description = "", string model = "", string instructions = "", struct options = {} ) { if ( !validName( arguments.name ) ) { return { success: false, error: "Agent name must contain only letters, numbers, hyphens, and underscores" } }; var path = agentPath( arguments.name ); if ( fileExists( path ) ) { return { success: false, error: "Agent already exists: #arguments.name#" } }; var content = "---" & char( 10 ) & "name: " & arguments.name & char( 10 ) & "description: " & arguments.description & char( 10 ) & "model: " & arguments.model & char( 10 ) & "options: " & jsonSerialize( arguments.options ) & char( 10 ) & "---" & char( 10 ) & char( 10 ) & arguments.instructions; fileWrite( path, content ); return parse( path ) }
	struct function update( required string name, string description = "", string model = "", string instructions = "", struct options = {} ) { var existing = show( arguments.name ); if ( structIsEmpty( existing ) ) { return { success: false, error: "Agent not found: #arguments.name#" } }; return overwrite( arguments.name, arguments.description ?: existing.metadata.description ?: "", arguments.model ?: existing.metadata.model ?: "", arguments.instructions ?: existing.instructions, arguments.options ) }
	struct function delete( required string name ) { var path = agentPath( arguments.name ); if ( !fileExists( path ) ) { return { success: false, error: "Agent not found: #arguments.name#" } }; fileDelete( path ); return { success: true, name: arguments.name } }
	struct function run( required string name, required string query, struct runtimeOptions = {} ) { if ( !len( arguments.query ) ) { return { success: false, error: "An agent query is required" } }; var definition = show( arguments.name ); if ( structIsEmpty( definition ) ) { return { success: false, error: "Agent not found: #arguments.name#" } }; var logicalProvider = arguments.runtimeOptions.provider ?: ( variables.config != null ? variables.config.get( "bx-ai.defaultProvider", "" ) : "" ); var providerConfig = variables.config != null ? variables.config.get( "bx-ai.providers.#logicalProvider#", {} ) : {}; var serviceProvider = isStruct( providerConfig ) && lCase( providerConfig.type ?: "" ) == "openai-compatible" ? "openai-compatible" : logicalProvider; var modelId = definition.metadata.model ?: ( variables.config != null ? variables.config.get( "bx-ai.defaultModel", "" ) : "" ); var modelParams = {}; if ( len( modelId ) ) { modelParams.model = modelId }; var modelOptions = duplicate( providerConfig.options ?: {} ); if ( isStruct( providerConfig ) && providerConfig.keyExists( "baseURL" ) ) { modelOptions.baseURL = providerConfig.baseURL }; if ( isStruct( providerConfig ) && providerConfig.keyExists( "apiKey" ) ) { modelOptions.apiKey = providerConfig.apiKey }; var model = len( serviceProvider ) ? aiModel( provider: serviceProvider, params: modelParams, options: modelOptions ) : aiModel( params: modelParams, options: modelOptions ); var alwaysOn = []; var lazy = []; var skillRoot = expandPath( ".agents/skills" ); var customRoot = expandPath( ".agents/skills-custom" ); var registrySkills = aiSkill( skillRoot ); var customSkills = aiSkill( customRoot ); for ( var loadedSkill in customSkills ) { var activation = loadActivation( loadedSkill ); if ( activation.enabled ) { new "models.skills.SkillManager"( expandPath( ".agents/skills" ) ).recordUse( loadedSkill.getName() ); if ( activation.mode == "always-on" ) { alwaysOn.append( loadedSkill ) } else { lazy.append( loadedSkill ) } } }; var agent = aiAgent( name: definition.metadata.name, description: definition.metadata.description ?: "", instructions: definition.instructions, model: model, params: definition.metadata.options ?: {}, skills: alwaysOn, availableSkills: lazy.append( registrySkills, true ) ); try { return { success: true, response: agent.run( arguments.query ), agent: definition.metadata.name, model: modelId, provider: logicalProvider } } catch ( any exception ) { return { success: false, error: exception.message ?: toString( exception ), agent: definition.metadata.name } } }
	private struct function loadActivation( required any skill ) { var path = skill.getFilePath(); var metadataPath = getDirectoryFromPath( path ) & "/.nanobox-skill.json"; if ( !fileExists( metadataPath ) ) { return { enabled: true, mode: "lazy" } }; var metadata = jsonDeserialize( fileRead( metadataPath ) ); return { enabled: metadata.enabled ?: true, mode: metadata.mode ?: "lazy" } }
	private struct function overwrite( required string name, required string description, required string model, required string instructions, struct options = {} ) { var path = agentPath( arguments.name ); var content = "---" & char( 10 ) & "name: " & arguments.name & char( 10 ) & "description: " & arguments.description & char( 10 ) & "model: " & arguments.model & char( 10 ) & "options: " & jsonSerialize( arguments.options ) & char( 10 ) & "---" & char( 10 ) & char( 10 ) & arguments.instructions; fileWrite( path, content ); return parse( path ) }
	private string function agentPath( required string name ) { return variables.agentsPath & "/" & arguments.name & ".md" }
	private boolean function validName( required string name ) { return len( arguments.name ) && reFind( "^[A-Za-z0-9_-]+$", arguments.name ) == 1 }
	private struct function parse( required string path ) { var content = fileRead( arguments.path ); var metadata = {}; var instructions = content; if ( left( content, 3 ) == "---" ) { var end = find( "---", content, 4 ); if ( end > 0 ) { var frontmatter = mid( content, 4, end - 4 ); for ( var line in listToArray( frontmatter, char( 10 ) ) ) { var clean = trim( line ); if ( left( clean, 5 ) == "name:" ) { metadata.name = trim( mid( clean, 6, len( clean ) ) ) }; if ( left( clean, 12 ) == "description:" ) { metadata.description = trim( mid( clean, 13, len( clean ) ) ) }; if ( left( clean, 6 ) == "model:" ) { metadata.model = trim( mid( clean, 7, len( clean ) ) ) }; if ( left( clean, 7 ) == "skills:" ) { metadata.skills = listToArray( trim( mid( clean, 8, len( clean ) ) ), "," ) } }; instructions = trim( mid( content, end + 3, len( content ) ) ) } }; return { path: arguments.path, metadata: metadata, instructions: instructions } }
}
