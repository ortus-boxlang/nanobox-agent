/**
 * AgentManager — file-based registry and runner for NanoBox agents.
 *
 * Agents are stored as Markdown files with YAML frontmatter in the agents
 * directory.  The run() method resolves the provider, assembles the bx-ai
 * agent with always-on and lazy-loaded skills, and executes the query.
 *
 * @author Ortus Solutions
 * @version 0.1.0
 * @since 0.1.0
 */
class {
	property agentsPath;
	property config;
	property securityMiddleware;

	/**
	 * @agentsPath       Directory containing agent Markdown files; defaults to ~/.nanobox/agents
	 * @configManager    Optional ConfigManager for provider and model resolution at run time
	 * @secretPatterns   Optional array of regex patterns for secret detection (defaults to common API key formats)
	 * @blockedTools     Optional array of tool names to block (empty means no tools blocked)
	 * @allowlistPath    Optional path to OsToolMiddleware allowlist JSON file
	 * @requireApproval  When true, dangerous OS tool calls require user approval (default: true)
	 */
	function init( string agentsPath = "", any configManager = null, array secretPatterns = [], array blockedTools = [], string allowlistPath = "", boolean requireApproval = true ) {
		variables.agentsPath = len( arguments.agentsPath ) ? arguments.agentsPath : expandPath( "~/.nanobox/agents" )
		variables.config = arguments.configManager
		variables.securityMiddleware = new "models.middleware.SecurityMiddleware"( arguments.secretPatterns, arguments.blockedTools )
		if ( !directoryExists( variables.agentsPath ) ) { directoryCreate( variables.agentsPath, true ) }
		return this
	}

	/**
	 * Returns all registered agents as an array of parsed definition structs.
	 *
	 * @return Array of agent structs with path, metadata, and instructions keys
	 */
	array function list() { var result = []; for ( var file in directoryList( variables.agentsPath, false, "query", "*.md" ) ) { result.append( parse( file.directory & "/" & file.name ) ) }; return result }

	/**
	 * Returns the unique set of skill names referenced across all agent definitions.
	 *
	 * @return Array of skill name strings
	 */
	array function referencedSkills() { var result = []; for ( var agent in list() ) { for ( var name in agent.metadata.skills ?: [] ) { if ( !result.contains( name ) ) { result.append( name ) } } }; return result }

	/**
	 * Returns a single agent definition by name.
	 *
	 * @name  Agent name (without .md extension)
	 * @return Agent struct, or empty struct if not found
	 */
	struct function show( required string name ) { var path = agentPath( arguments.name ); return fileExists( path ) ? parse( path ) : {} }

	/**
	 * Creates a new agent definition file.
	 *
	 * @name          Agent name — must match [A-Za-z0-9_-]+
	 * @description   Short description of the agent's purpose
	 * @model         Model override (empty uses the global default)
	 * @instructions  System prompt / instruction text
	 * @options       Additional model options struct
	 * @return Agent struct, or error struct on failure
	 */
	struct function create( required string name, string description = "", string model = "", string instructions = "", struct options = {} ) { if ( !validName( arguments.name ) ) { return { success: false, error: "Agent name must contain only letters, numbers, hyphens, and underscores" } }; var path = agentPath( arguments.name ); if ( fileExists( path ) ) { return { success: false, error: "Agent already exists: #arguments.name#" } }; var content = "---" & char( 10 ) & "name: " & arguments.name & char( 10 ) & "description: " & arguments.description & char( 10 ) & "model: " & arguments.model & char( 10 ) & "options: " & jsonSerialize( arguments.options ) & char( 10 ) & "---" & char( 10 ) & char( 10 ) & arguments.instructions; fileWrite( path, content ); return parse( path ) }

	/**
	 * Updates an existing agent definition, merging supplied values with current ones.
	 *
	 * @name          Agent name to update
	 * @description   Updated description (empty keeps existing)
	 * @model         Updated model (empty keeps existing)
	 * @instructions  Updated instructions (empty keeps existing)
	 * @options       Updated options struct
	 * @return Updated agent struct, or error struct if not found
	 */
	struct function update( required string name, string description = "", string model = "", string instructions = "", struct options = {} ) { var existing = show( arguments.name ); if ( structIsEmpty( existing ) ) { return { success: false, error: "Agent not found: #arguments.name#" } }; return overwrite( arguments.name, arguments.description ?: existing.metadata.description ?: "", arguments.model ?: existing.metadata.model ?: "", arguments.instructions ?: existing.instructions, arguments.options ) }

	/**
	 * Deletes an agent definition file.
	 *
	 * @name  Agent name to delete
	 * @return Struct with success flag and agent name
	 */
	struct function delete( required string name ) { var path = agentPath( arguments.name ); if ( !fileExists( path ) ) { return { success: false, error: "Agent not found: #arguments.name#" } }; fileDelete( path ); return { success: true, name: arguments.name } }

	/**
	 * Runs an agent against a query.
	 *
	 * Resolves the provider from config, loads always-on and lazy skills from
	 * the custom skills directory, and delegates to the bx-ai agent loop.
	 * Security middleware is applied before and after the agent call.
	 *
	 * @name            Agent name to run
	 * @query           User query / task to pass to the agent
	 * @runtimeOptions  Optional overrides (provider, etc.)
	 * @return Struct with success, response, agent, model, and provider keys
	 */
	struct function run( required string name, required string query, struct runtimeOptions = {} ) {
		if ( !len( arguments.query ) ) { return { success: false, error: "An agent query is required" } }
		var definition = show( arguments.name )
		if ( structIsEmpty( definition ) ) { return { success: false, error: "Agent not found: #arguments.name#" } }

		// SecurityMiddleware: check query for secrets before LLM call
		var llmContext = { messages: arguments.query }
		var securityResult = variables.securityMiddleware.beforeLLMCall( llmContext )
		if ( !securityResult.continue ) { return { success: false, error: securityResult.message } }

		var logicalProvider = arguments.runtimeOptions.provider ?: ( variables.config != null ? variables.config.get( "bx-ai.defaultProvider", "" ) : "" )
		var providerConfig = variables.config != null ? variables.config.get( "bx-ai.providers.#logicalProvider#", {} ) : {}
		var serviceProvider = isStruct( providerConfig ) && lCase( providerConfig.type ?: "" ) == "openai-compatible" ? "openai-compatible" : logicalProvider
		var modelId = definition.metadata.model ?: ( variables.config != null ? variables.config.get( "bx-ai.defaultModel", "" ) : "" )
		var modelParams = {}
		if ( len( modelId ) ) { modelParams.model = modelId }
		var modelOptions = duplicate( providerConfig.options ?: {} )
		if ( isStruct( providerConfig ) && providerConfig.keyExists( "baseURL" ) ) { modelOptions.baseURL = providerConfig.baseURL }
		if ( isStruct( providerConfig ) && providerConfig.keyExists( "apiKey" ) ) { modelOptions.apiKey = providerConfig.apiKey }
		var model = len( serviceProvider ) ? aiModel( provider: serviceProvider, params: modelParams, options: modelOptions ) : aiModel( params: modelParams, options: modelOptions )
		var alwaysOn = []
		var lazy = []
		var skillRoot = expandPath( ".agents/skills" )
		var customRoot = expandPath( ".agents/skills-custom" )
		var registrySkills = aiSkill( skillRoot )
		var customSkills = aiSkill( customRoot )
		for ( var loadedSkill in customSkills ) {
			var activation = loadActivation( loadedSkill )
			if ( activation.enabled ) {
				new "models.skills.SkillManager"( expandPath( ".agents/skills" ) ).recordUse( loadedSkill.getName() )
				if ( activation.mode == "always-on" ) { alwaysOn.append( loadedSkill ) } else { lazy.append( loadedSkill ) }
			}
		}
		for ( var loadedSkill in registrySkills ) {
			var activation = loadActivation( loadedSkill )
			if ( activation.enabled ) {
				new "models.skills.SkillManager"( expandPath( ".agents/skills" ) ).recordUse( loadedSkill.getName() )
				if ( activation.mode == "always-on" ) { alwaysOn.append( loadedSkill ) } else { lazy.append( loadedSkill ) }
			}
		}

		try {
			var response = aiAgent( definition.instructions, model, alwaysOn, lazy )
			var content = isStruct( response ) ? ( response.content ?: "" ) : response

			// SecurityMiddleware: check response for leaked secrets
			var responseContext = { response: content }
			var postSecurityResult = variables.securityMiddleware.afterAgentRun( responseContext )
			if ( !postSecurityResult.continue ) { return { success: false, error: postSecurityResult.message } }

			return { success: true, response: content, agent: definition.name, model: modelId, provider: logicalProvider, raw: response }
		} catch ( any exception ) { return { success: false, error: exception.message ?: toString( exception ) } }
	}

	/**
	 * Reads a skill's activation metadata from its .nanobox-skill.json sidecar file.
	 *
	 * @skill  Loaded skill object with getFilePath() method
	 * @return Struct with enabled (boolean) and mode ("always-on"|"lazy") keys
	 */
	private struct function loadActivation( required any skill ) { var path = skill.getFilePath(); var metadataPath = getDirectoryFromPath( path ) & "/.nanobox-skill.json"; if ( !fileExists( metadataPath ) ) { return { enabled: true, mode: "lazy" } }; var metadata = jsonDeserialize( fileRead( metadataPath ) ); return { enabled: metadata.enabled ?: true, mode: metadata.mode ?: "lazy" } }

	/**
	 * Overwrites an agent definition file with updated values.
	 *
	 * @name          Agent name
	 * @description   Description text
	 * @model         Model identifier
	 * @instructions  Instruction text
	 * @options       Options struct
	 * @return Parsed agent struct after writing
	 */
	private struct function overwrite( required string name, required string description, required string model, required string instructions, struct options = {} ) { var path = agentPath( arguments.name ); var content = "---" & char( 10 ) & "name: " & arguments.name & char( 10 ) & "description: " & arguments.description & char( 10 ) & "model: " & arguments.model & char( 10 ) & "options: " & jsonSerialize( arguments.options ) & char( 10 ) & "---" & char( 10 ) & char( 10 ) & arguments.instructions; fileWrite( path, content ); return parse( path ) }

	/**
	 * Returns the filesystem path for an agent name.
	 *
	 * @name  Agent name
	 * @return Absolute path string to the .md file
	 */
	private string function agentPath( required string name ) { return variables.agentsPath & "/" & arguments.name & ".md" }

	/**
	 * Validates that a name contains only safe characters for a filename.
	 *
	 * @name  Name to validate
	 * @return true if the name matches [A-Za-z0-9_-]+
	 */
	private boolean function validName( required string name ) { return len( arguments.name ) && reFind( "^[A-Za-z0-9_-]+$", arguments.name ) == 1 }

	/**
	 * Parses an agent Markdown file and extracts YAML frontmatter and instruction body.
	 *
	 * @path  Absolute path to the agent .md file
	 * @return Struct with path, metadata (name, description, model, skills, options), and instructions keys
	 */
	private struct function parse( required string path ) { var content = fileRead( arguments.path ); var metadata = {}; var instructions = content; if ( left( content, 3 ) == "---" ) { var end = find( "---", content, 4 ); if ( end > 0 ) { var frontmatter = mid( content, 4, end - 4 ); for ( var line in listToArray( frontmatter, char( 10 ) ) ) { var clean = trim( line ); if ( left( clean, 5 ) == "name:" ) { metadata.name = trim( mid( clean, 6, len( clean ) ) ) }; if ( left( clean, 12 ) == "description:" ) { metadata.description = trim( mid( clean, 13, len( clean ) ) ) }; if ( left( clean, 6 ) == "model:" ) { metadata.model = trim( mid( clean, 7, len( clean ) ) ) }; if ( left( clean, 7 ) == "skills:" ) { metadata.skills = listToArray( trim( mid( clean, 8, len( clean ) ) ), "," ) } }; instructions = trim( mid( content, end + 3, len( content ) ) ) } }; return { path: arguments.path, metadata: metadata, instructions: instructions } }
}
