/**
 * SecurityCzar — content-scanning security layer for NanoBox.
 *
 * Scans text content for dangerous patterns (leaked API keys, prompt injection,
 * dangerous Java class references) and writes findings to a JSON report file.
 * Also exposes a scheduled tick for background scanning.
 *
 * @author Ortus Solutions
 * @version 0.1.0
 * @since 0.1.0
 */
class {
	property quarantinePath;
	property reportPath;
	property patterns;

	/**
	 * @quarantinePath  Directory for quarantined files; defaults to ~/.nanobox/quarantine
	 * @reportPath      Path to the JSON security report; defaults to ~/.nanobox/security-report.json
	 */
	function init( string quarantinePath = "", string reportPath = "" ) {
		variables.quarantinePath = arguments.quarantinePath != "" ? arguments.quarantinePath : expandPath( "~/.nanobox/quarantine" )
		variables.reportPath = arguments.reportPath != "" ? arguments.reportPath : expandPath( "~/.nanobox/security-report.json" )
		variables.patterns = [ "sk-[A-Za-z0-9]{20,}", "sk-ant-[A-Za-z0-9_-]{20,}", "ghp_[A-Za-z0-9]{36}", "AKIA[0-9A-Z]{16}", "ignore previous instructions", "systemExecute", "processBuilder" ]
		if ( !directoryExists( variables.quarantinePath ) ) { directoryCreate( variables.quarantinePath, true ) }
		return this
	}

	/**
	 * Scans a single content string against all registered threat patterns.
	 *
	 * Each matching pattern contributes a finding with a severity rating.
	 * The result is written to the report file and returned to the caller.
	 *
	 * @type     Logical content type label (e.g. "skills", "vault")
	 * @name     Display name for the scanned item
	 * @content  Raw text content to scan
	 * @return   Struct with type, name, findings array, scanned timestamp, and status ("clean"|"threat")
	 */
	struct function scan( required string type, required string name, required string content ) {
		var findings = []
		for ( var pattern in variables.patterns ) { if ( reFindNoCase( pattern, arguments.content ) ) { findings.append( { pattern: pattern, severity: pattern.findNoCase( "ignore" ) ? "high" : "critical" } ) } }
		var result = { type: arguments.type, name: arguments.name, findings: findings, scanned: now(), status: findings.len() ? "threat" : "clean" }
		writeReport( result )
		return result
	}

	/**
	 * Scans all .md files in a directory tree.
	 *
	 * @type       Logical content type label passed to scan()
	 * @directory  Root directory to traverse
	 * @return     Array of scan result structs, one per file
	 */
	array function scanFiles( required string type, required string directory ) {
		var results = []
		if ( !directoryExists( arguments.directory ) ) { return results }
		for ( var file in directoryList( arguments.directory, true, "query", "*.md" ) ) { if ( file.type == "File" ) { results.append( scan( arguments.type, file.name, fileRead( file.directory & "/" & file.name ) ) ) } }
		return results
	}

	/**
	 * Returns the quarantine directory path.
	 *
	 * @return Absolute path to the quarantine directory
	 */
	string function getQuarantinePath() { return variables.quarantinePath }

	/**
	 * Returns the report file path.
	 *
	 * @return Absolute path to the JSON security report file
	 */
	string function getReportPath() { return variables.reportPath }

	/**
	 * Returns the registered threat-pattern count.
	 *
	 * @return Number of security patterns currently loaded
	 */
	numeric function getPatternCount() { return variables.patterns.len() }

	/**
	 * Returns the last written security report.
	 *
	 * @return Parsed report struct, or {status: "never-scanned"} when no report exists
	 */
	struct function status() { return fileExists( variables.reportPath ) ? jsonDeserialize( fileRead( variables.reportPath ) ) : { status: "never-scanned" } }

	/**
	 * Performs a background security scan tick (called by the scheduled worker).
	 *
	 * Scans all files under the given root directory and logs outcomes.
	 *
	 * @scope  Logical scope label for logging (default "skills")
	 * @root   Override scan root; defaults to quarantinePath
	 * @return Struct with success, scanned count, threats count, findings, scope, and duration keys
	 */
	struct function tick( string scope = "skills", string root = "" ) {
		var scanRoot = len( arguments.root ) ? arguments.root : variables.quarantinePath
		var start = now()
		writeLog( text="Security scan tick starting — scope=#arguments.scope#, root=#scanRoot#", type="information", log="nanobox-security" )
		try {
			if ( !directoryExists( scanRoot ) ) {
				writeLog( text="Security scan tick complete — no content to scan (#scanRoot#)", type="debug", log="nanobox-security" )
				return { success: true, scanned: 0, threats: 0, scope: arguments.scope, duration: dateDiff( "s", start, now() ) }
			}
			var results = scanFiles( arguments.scope, scanRoot )
			writeLog( text="Security scan tick complete — scope=#arguments.scope#, threats=#results.len()#, duration=#dateDiff( 's', start, now() )#s", type="information", log="nanobox-security" )
			if ( results.len() ) {
				writeLog( text="Security scan found #results.len()# threats in #arguments.scope#", type="warning", log="nanobox-security" )
			}
			return { success: true, scanned: 1, threats: results.len(), findings: results, scope: arguments.scope, duration: dateDiff( "s", start, now() ) }
		} catch ( any e ) {
			writeLog( text="Security scan tick failed: #e.message#", type="error", log="nanobox-security" )
			return { success: false, error: e.message }
		}
	}

	/**
	 * Writes a scan result struct to the JSON report file.
	 *
	 * @result  Scan result struct to serialise
	 */
	private void function writeReport( required struct result ) { fileWrite( variables.reportPath, jsonSerialize( arguments.result, true ) ) }
}
