/**
 * Scheduler — in-process task scheduler using BoxLang's native scheduler API.
 *
 * Reads enabled cron tasks from CronManager and registers each one with a
 * BoxLang Scheduler via the schedulerNew() BIF so they execute in-process
 * without requiring a separate worker process.  Supports start, stop,
 * restart, status, and stats operations.
 *
 * The scheduler tasks run aiChat() with the configured prompt for each
 * firing and record run/failure outcomes back to CronManager.
 *
 * @author Ortus Solutions
 * @version 0.1.0
 * @since 0.1.0
 */
class {

	property name="cronManager";
	property name="schedulerName";
	property name="scheduler";

	/**
	 * @cronManager    CronManager instance for reading and recording cron tasks
	 * @schedulerName  Optional name for the BoxLang scheduler (default "nanobox-scheduler")
	 */
	function init( required any cronManager, string schedulerName = "nanobox-scheduler" ) {
		variables.cronManager   = arguments.cronManager
		variables.schedulerName = arguments.schedulerName
		return this
	}

	/**
	 * Starts the in-process scheduler, registering all enabled cron tasks.
	 *
	 * Creates a new BoxLang scheduler via schedulerNew(), loads every enabled
	 * cron task from CronManager, and registers each one with its cron expression.
	 * Returns immediately after startup — tasks fire on their schedule.
	 *
	 * @return Struct with success, status, registered (count), and name keys
	 */
	struct function start() {
		if ( !isNull( variables.scheduler ) && variables.scheduler.isRunning() ) {
			return { success: true, status: "running", name: variables.schedulerName }
		}

		variables.scheduler = schedulerNew( variables.schedulerName, "UTC", true )
		variables.scheduler.setSchedulerName( variables.schedulerName )

		var tasks   = variables.cronManager.list()
		var registered = 0

		for ( var task in tasks ) {
			if ( !( task.enabled ?: false ) ) { continue }
			if ( !len( task.schedule ?: "" ) || !len( task.prompt ?: "" ) ) { continue }
			registerTask( task )
			registered++
		}

		variables.scheduler.startup()

		return { success: true, status: "started", registered: registered, name: variables.schedulerName }
	}

	/**
	 * Gracefully stops the scheduler and all its registered tasks.
	 *
	 * @force   When true, force-stops the scheduler (default false)
	 * @timeout Timeout in seconds to wait for graceful shutdown (default 30)
	 * @return  Struct with success, status, and name keys
	 */
	struct function stop( boolean force = false, numeric timeout = 30 ) {
		if ( isNull( variables.scheduler ) ) {
			return { success: true, status: "stopped", name: variables.schedulerName }
		}
		try {
			schedulerShutdown( variables.schedulerName, arguments.force, arguments.timeout )
			variables.scheduler = null
		} catch ( any e ) {
			return { success: false, error: e.message, status: "error", name: variables.schedulerName }
		}
		return { success: true, status: "stopped", name: variables.schedulerName }
	}

	/**
	 * Stops then restarts the scheduler, reloading all tasks from CronManager.
	 *
	 * @return Result of the start() call
	 */
	struct function restart() {
		stop()
		return start()
	}

	/**
	 * Returns the current status of the scheduler.
	 *
	 * @return Struct with name, status (running|stopped), tasks (array), and stats keys
	 */
	struct function status() {
		if ( isNull( variables.scheduler ) || !variables.scheduler.isRunning() ) {
			return { name: variables.schedulerName, status: "stopped" }
		}
		var tasks      = variables.scheduler.getRegisteredTasks()
		var taskStats  = []
		for ( var taskName in tasks ) {
			var record = variables.scheduler.getTaskRecord( taskName )
			taskStats.append( {
				name:     taskName,
				disabled: record.disabled ?: false,
				runs:     record.task.getStats().totalRuns ?: 0,
				failures: record.task.getStats().totalFailures ?: 0
			} )
		}
		return {
			name:     variables.schedulerName,
			status:   "running",
			started:  variables.scheduler.getStartedAt(),
			tasks:    taskStats
		}
	}

	/**
	 * Returns aggregate statistics for all scheduler tasks.
	 *
	 * @return Struct with name, status, taskCount, totalRuns, and totalFailures keys
	 */
	struct function stats() {
		var st = status()
		if ( st.status != "running" ) {
			return { name: variables.schedulerName, status: "stopped", taskCount: 0, totalRuns: 0, totalFailures: 0 }
		}
		var totalRuns     = 0
		var totalFailures = 0
		for ( var t in st.tasks ) {
			totalRuns     += t.runs
			totalFailures += t.failures
		}
		return {
			name:          variables.schedulerName,
			status:        "running",
			taskCount:     st.tasks.len(),
			totalRuns:     totalRuns,
			totalFailures: totalFailures
		}
	}

	/**
	 * Registers a single cron task with the BoxLang scheduler.
	 *
	 * @task  Struct from CronManager with name, schedule, and prompt keys
	 */
	private void function registerTask( required struct task ) {
		var taskName   = "cron-#arguments.task.name#"
		var taskPrompt = arguments.task.prompt
		var taskCron   = arguments.task.schedule
		var taskDb     = variables.cronManager

		variables.scheduler.task( taskName )
			.call( () => executeTask( arguments.task.name, taskPrompt, taskDb ) )
			.cron( taskCron )
	}

	/**
	 * Executes a single cron task — sends the prompt via aiChat() and
	 * records the outcome (success/failure) to CronManager.
	 *
	 * @taskName  Cron task name for logging and result recording
	 * @prompt    AI prompt to send
	 * @cronDb    CronManager instance for recording run/failure
	 */
	private void function executeTask(
		required string taskName,
		required string prompt,
		required any    cronDb
	) {
		taskName = arguments.taskName
		try {
			aiChat( arguments.prompt )
			arguments.cronDb.run( arguments.taskName )
		} catch ( any e ) {
			arguments.cronDb.fail( arguments.taskName )
		}
	}

}
