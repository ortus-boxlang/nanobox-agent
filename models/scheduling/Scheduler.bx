/**
 * Scheduler — thin façade over WorkerSupervisor for use by domain code.
 *
 * The real scheduling work is done by the BoxLang native scheduler running
 * {@code worker/nanobox-worker.bx}.  This class lets other domain models start,
 * stop, and query the worker process without coupling to WorkerCommand.
 *
 * @author Ortus Solutions
 * @version 0.1.0
 * @since 0.1.0
 */
class {

	property supervisor;

	/**
	 * @processManager ProcessManager instance used to spawn and track the worker process
	 * @projectRoot    Absolute path to the project root; defaults to the current directory
	 */
	function init( required any processManager, string projectRoot = "" ) {
		variables.supervisor = new "worker.core.WorkerSupervisor"(
			arguments.processManager,
			len( arguments.projectRoot ) ? arguments.projectRoot : expandPath( "." )
		)
		return this
	}

	/**
	 * Starts the BoxLang worker scheduler process.
	 *
	 * @return Struct with success, status, pid, and name keys
	 */
	struct function start()   { return variables.supervisor.start() }

	/**
	 * Stops the worker process.
	 *
	 * @return Struct with success, status, name, and pid keys
	 */
	struct function stop()    { return variables.supervisor.stop() }

	/**
	 * Stops then restarts the worker process.
	 *
	 * @return Result of the start call
	 */
	struct function restart() { return variables.supervisor.restart() }

	/**
	 * Returns the current status of the worker process.
	 *
	 * @return Struct with name, status (running|stopped), pid, started, and command keys
	 */
	struct function status()  { return variables.supervisor.status() }

	/**
	 * Returns a summary of the worker process suitable for dashboard display.
	 *
	 * @return Struct with name, status, pid, and started keys
	 */
	struct function stats() {
		var proc = variables.supervisor.status()
		return {
			name:    "nanobox-worker",
			status:  proc.status ?: "stopped",
			pid:     proc.pid ?: "",
			started: proc.started ?: ""
		}
	}

}
