/**
 * VaultManager — file-and-SQLite knowledge vault for NanoBox.
 *
 * Documents are stored as files under category sub-directories (reports,
 * research, imported, manual) and indexed in the {@code nanobox_vault_documents}
 * SQLite table.  The index() method syncs the filesystem into SQLite so
 * AI tools can query content via full-text search.
 *
 * @author Ortus Solutions
 * @version 0.1.0
 * @since 0.1.0
 */
class {
	property datasource;
	property vaultPath;

	/**
	 * @vaultPath  Root directory for vault storage; defaults to ~/.nanobox/vault
	 */
	function init( string vaultPath = "" ) {
		variables.datasource = "nanobox"
		variables.vaultPath = len( arguments.vaultPath ) ? arguments.vaultPath : expandPath( "~/.nanobox/vault" )
		ensureDirectories()
		ensureTable()
		return this
	}

	/**
	 * Imports a file into the vault by copying it and recording the metadata in SQLite.
	 *
	 * The category is normalised to one of: reports, research, imported, manual.
	 *
	 * @sourcePath  Absolute path to the file to import
	 * @category    Target category (default "imported")
	 * @tags        Optional array of tag strings
	 * @return      Struct with success flag and document metadata
	 */
	struct function importFile( required string sourcePath, string category = "imported", array tags = [] ) {
		if ( !fileExists( arguments.sourcePath ) ) {
			return { success: false, error: "File not found: #arguments.sourcePath#" }
		}
		var safe = [ "reports", "research", "imported", "manual" ].contains( lCase( arguments.category ) )
			? lCase( arguments.category )
			: "imported"
		var name = getFileFromPath( arguments.sourcePath )
		var destDir = variables.vaultPath & "/" & safe
		if ( !directoryExists( destDir ) ) { directoryCreate( destDir, true ) }
		var destination = destDir & "/" & name
		fileCopy( arguments.sourcePath, destination, true )
		var id = createUUID()
		var content = fileRead( arguments.sourcePath )
		var tagStr = arrayToList( arguments.tags, "," )
		queryExecute(
			"INSERT INTO nanobox_vault_documents (id, name, path, category, tags, content) VALUES (:id, :name, :path, :category, :tags, :content)",
			{ id: id, name: name, path: destination, category: safe, tags: tagStr, content: content },
			{ datasource: variables.datasource }
		)
		return { success: true, document: { id: id, name: name, path: destination, category: safe, tags: arguments.tags, content: content } }
	}

	/**
	 * Returns all vault documents, optionally filtered by category.
	 *
	 * @category  Category to filter by; empty string returns all categories
	 * @return    Array of document metadata structs (without content)
	 */
	array function list( string category = "" ) {
		var sql = "SELECT id, name, path, category, tags, created_at, modified_at FROM nanobox_vault_documents"
		var params = {}
		if ( len( arguments.category ) ) { sql &= " WHERE category = :category"; params.category = arguments.category }
		sql &= " ORDER BY created_at DESC"
		var query = queryExecute( sql, params, { datasource: variables.datasource } )
		return rowsToArray( query )
	}

	/**
	 * Returns a single document by ID or name, including its full content.
	 *
	 * @id  Document UUID or name
	 * @return Document struct with id, name, path, category, tags, content, and timestamps,
	 *         or empty struct if not found
	 */
	struct function get( required string id ) {
		var query = queryExecute(
			"SELECT id, name, path, category, tags, content, created_at, modified_at FROM nanobox_vault_documents WHERE id = :id OR name = :id",
			{ id: arguments.id },
			{ datasource: variables.datasource }
		)
		return query.recordCount ? rowsToArray( query ).first() : {}
	}

	/**
	 * Full-text search across name, category, tags, and content.
	 *
	 * @query  Search string (wrapped in SQL wildcards)
	 * @limit  Maximum number of results (clamped to 1–500)
	 * @return Array of matching document structs with full content
	 */
	array function search( required string query, numeric limit = 20 ) {
		var safe = max( 1, min( 500, int( arguments.limit ) ) )
		var result = queryExecute(
			"SELECT id, name, path, category, tags, content, created_at, modified_at FROM nanobox_vault_documents WHERE name LIKE :q OR category LIKE :q OR tags LIKE :q OR content LIKE :q ORDER BY created_at DESC LIMIT #safe#",
			{ q: "%#arguments.query#%" },
			{ datasource: variables.datasource }
		)
		return rowsToArray( result )
	}

	/**
	 * Synchronises the filesystem vault directories into the SQLite index.
	 *
	 * Scans all files under the four category directories and upserts each one
	 * into the database.  New files are inserted; existing files are updated
	 * with their current content.
	 *
	 * @return Struct with success, total (indexed count), and imported (files found) keys
	 */
	struct function index() {
		var manifest = { documents: [] }
		for ( var category in [ "reports", "research", "imported", "manual" ] ) {
			var catDir = variables.vaultPath & "/" & category
			if ( !directoryExists( catDir ) ) { continue }
			for ( var file in directoryList( catDir, true, "query" ) ) {
				if ( file.type == "file" && file.name != ".index.json" ) {
					manifest.documents.append( {
						name: file.name,
						path: file.directory & "/" & file.name,
						category: category,
						content: fileRead( file.directory & "/" & file.name ),
						modified: file.dateLastModified
					} )
				}
			}
		}
		// Upsert each found file into SQLite
		for ( var doc in manifest.documents ) {
			var existing = queryExecute(
				"SELECT id FROM nanobox_vault_documents WHERE name = :name AND category = :category",
				{ name: doc.name, category: doc.category },
				{ datasource: variables.datasource }
			)
			if ( existing.recordCount ) {
				queryExecute(
					"UPDATE nanobox_vault_documents SET path = :path, content = :content, modified_at = CURRENT_TIMESTAMP WHERE id = :id",
					{ path: doc.path, content: doc.content, id: existing.id[ 1 ] },
					{ datasource: variables.datasource }
				)
			} else {
				var id = createUUID()
				queryExecute(
					"INSERT INTO nanobox_vault_documents (id, name, path, category, content) VALUES (:id, :name, :path, :category, :content)",
					{ id: id, name: doc.name, path: doc.path, category: doc.category, content: doc.content },
					{ datasource: variables.datasource }
				)
			}
		}
		var total = queryExecute( "SELECT COUNT(*) AS cnt FROM nanobox_vault_documents", {}, { datasource: variables.datasource } )
		return { success: true, total: total.cnt[ 1 ] ?: 0, imported: manifest.documents.len() }
	}

	/**
	 * Deletes a document from both the filesystem and the SQLite index.
	 *
	 * @id  Document UUID or name
	 * @return Struct with success flag and deleted document ID
	 */
	struct function remove( required string id ) {
		var doc = get( arguments.id )
		if ( structIsEmpty( doc ) ) { return { success: false, error: "Document not found: #arguments.id#" } }
		if ( fileExists( doc.path ) ) { fileDelete( doc.path ) }
		queryExecute( "DELETE FROM nanobox_vault_documents WHERE id = :id", { id: doc.id }, { datasource: variables.datasource } )
		return { success: true, id: doc.id }
	}

	/**
	 * Exports a document's content, optionally writing it to a file.
	 *
	 * @id      Document UUID or name
	 * @output  Optional file path to write the content to
	 * @return  Struct with success, id, output path, and content keys
	 */
	struct function export( required string id, string output = "" ) {
		var doc = get( arguments.id )
		if ( structIsEmpty( doc ) ) { return { success: false, error: "Document not found: #arguments.id#" } }
		var content = doc.content ?: ( fileExists( doc.path ) ? fileRead( doc.path ) : "" )
		if ( len( arguments.output ) ) { fileWrite( arguments.output, content ) }
		return { success: true, id: doc.id, output: arguments.output, content: content }
	}

	/**
	 * Returns the root vault directory path.
	 *
	 * @return Absolute path string
	 */
	string function getVaultPath() { return variables.vaultPath }

	/**
	 * Creates the nanobox_vault_documents table if it does not already exist.
	 */
	private void function ensureTable() {
		queryExecute( "
			CREATE TABLE IF NOT EXISTS nanobox_vault_documents (
				id TEXT PRIMARY KEY,
				name TEXT,
				path TEXT,
				category TEXT,
				tags TEXT DEFAULT '',
				content TEXT,
				created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
				modified_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
			)
		", {}, { datasource: variables.datasource } )
	}

	/**
	 * Creates the four category sub-directories under vaultPath if missing.
	 */
	private void function ensureDirectories() {
		for ( var category in [ "reports", "research", "imported", "manual" ] ) {
			var dir = variables.vaultPath & "/" & category
			if ( !directoryExists( dir ) ) { directoryCreate( dir, true ) }
		}
	}

	/**
	 * Converts a query result to an array of structs, splitting the tags column into an array.
	 *
	 * @data  Query result to convert
	 * @return Array of document structs with tags as an array
	 */
	private array function rowsToArray( required query data ) {
		var rows = []
		for ( var rowIndex = 1; rowIndex <= arguments.data.recordCount; rowIndex++ ) {
			var row = {}
			for ( var column in arguments.data.columnList.listToArray() ) {
				var val = arguments.data[ column ][ rowIndex ]
				if ( column == "tags" && isSimpleValue( val ) && len( val ) ) {
					row[ column ] = listToArray( val, "," )
				} else {
					row[ column ] = val
				}
			}
			rows.append( row )
		}
		return rows
	}
}
