class {
	property reportRoot;
	property vault;
	property config;
	property gateways;
	function init( string projectRoot = "", any vaultManager = null, any configManager = null, any gatewayRegistry = null ) { var root = len( arguments.projectRoot ) ? arguments.projectRoot : expandPath( "." ); variables.reportRoot = root & "/.agents/curator-reports"; variables.vault = arguments.vaultManager; variables.config = arguments.configManager; variables.gateways = arguments.gatewayRegistry; if ( !directoryExists( variables.reportRoot ) ) { directoryCreate( variables.reportRoot, true ) }; return this }
	struct function write( required struct curatorResult, string model = "" ) { var id = dateFormat( now(), "yyyymmdd" ) & "-" & timeFormat( now(), "HHmmss" ) & "-" & left( replace( createUUID(), "-", "", "all" ), 6 ); var dir = variables.reportRoot & "/" & id; directoryCreate( dir, true ); var report = { id: id, createdAt: now(), model: arguments.model, result: arguments.curatorResult }; fileWrite( dir & "/run.json", jsonSerialize( report, true ) ); var markdown = "## NanoBox Skill Curator Report" & char( 10 ) & char( 10 ) & "- Run: " & dateTimeFormat( now(), "yyyy-mm-dd HH:nn:ss" ) & char( 10 ) & "- Model: " & ( arguments.model ?: "deterministic" ) & char( 10 ) & "- Checked: " & ( arguments.curatorResult.checked ?: 0 ) & char( 10 ) & "- Dry run: " & ( arguments.curatorResult.dryRun ?: false ) & char( 10 ) & char( 10 ) & "## Changes" & char( 10 ) & char( 10 ); for ( var change in arguments.curatorResult.changes ?: [] ) { markdown &= "- " & change.name & ": " & change.from & " → " & change.to & " (" & change.ageDays & " days)" & char( 10 ) }; fileWrite( dir & "/REPORT.md", markdown ); var vaultResult = {}; if ( !isNull( variables.vault ) ) { vaultResult = variables.vault.importFile( dir & "/REPORT.md", "reports", [ "curator", id ] ) }; var delivery = deliver( markdown, id ); return { success: true, id: id, path: dir, vault: vaultResult, delivery: delivery } }
	private struct function deliver( required string content, required string id ) { var settings = variables.config != null ? variables.config.get( "curator.reportDelivery", {} ) : {}; if ( !( settings.enabled ?: false ) ) { return { enabled: false, delivered: false } }; if ( isNull( variables.gateways ) ) { return { enabled: true, delivered: false, error: "Gateway registry unavailable" } }; var target = settings.gateway ?: ""; var recipient = settings.recipient ?: ""; if ( !len( target ) || !len( recipient ) ) { return { enabled: true, delivered: false, error: "Gateway and recipient are required" } }; var message = settings.mode == "full" ? arguments.content : "NanoBox curator report #arguments.id#"; try { var gateway = variables.gateways.get( target ); if ( !isObject( gateway ) ) { return { enabled: true, delivered: false, error: "Gateway not found" } }; var result = gateway.send( recipient, message ); return { enabled: true, delivered: result.success ?: false, gateway: target, recipient: recipient, result: result } } catch ( any exception ) { return { enabled: true, delivered: false, error: exception.message ?: toString( exception ) } } }
}
